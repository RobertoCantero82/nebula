---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import Cabecera from '../components/Cabecera.astro';

const proyectos = [
  {
    id: 'indy', nombre: 'Indy', tema: 'Cine · Inteligencia artificial', estado: 'Acceso público',
    titular: 'Antes de darle al play, pregunta a Indy.',
    descripcion: 'He creado un compañero de conversación para esa duda que aparece antes de ver una película: ¿merecerá la pena? Un título es el punto de partida para hablar de cine y decidir qué ver.',
    imagen: 'agente-indy.png', ancho: 1466, alto: 888,
    alt: 'Inicio de Indy: un perro con sombrero de explorador y el botón Chat con Indy sobre un fondo de aventuras.',
    pie: 'Un título, una conversación y una decisión pendiente.',
    enlace: 'https://robertocantero-agente-indy.hf.space/', accion: 'Hablar con Indy',
    detalle: 'Qué puedes hacer',
    puntos: ['Abrir el chat y empezar por una película.', 'Utilizar la conversación para ayudarte a decidir qué ver.'],
    limite: 'Es una herramienta de inteligencia artificial: sus respuestas pueden contener errores.',
  },
  {
    id: 'mvp', nombre: 'Agente MVP', tema: 'Baloncesto · Datos', estado: 'Acceso público',
    titular: 'La NBA también se disfruta sin saber el resultado.',
    descripcion: 'Reúno la jornada NBA en una herramienta para seguir los partidos con o sin spoilers. También puedo hacer preguntas y consultar los datos de los encuentros de la temporada actual.',
    imagen: 'agente-mvp.png', ancho: 1405, alto: 881,
    alt: 'Agente MVP con el resumen de una jornada NBA, el análisis de los partidos y su buscador de preguntas.',
    pie: 'La jornada, sus historias y los datos para seguir preguntando.',
    enlace: 'https://robertocantero-mvp-nba.static.hf.space/index.html', accion: 'Explorar la jornada',
    detalle: 'Qué puedes hacer',
    puntos: ['Consultar jornadas y revelar los resultados cuando quieras.', 'Explorar los partidos y preguntar por los datos de la temporada actual.'],
    limite: 'Las fechas de los partidos corresponden a Estados Unidos. La información depende de los datos disponibles en la herramienta.',
  },
  {
    id: 'snap', nombre: 'Radar Marvel Snap', tema: 'Videojuegos · Automatización', estado: 'Acceso público',
    titular: 'Tu próximo mazo empieza con las cartas que tienes.',
    descripcion: 'He preparado un radar para descubrir combinaciones de cartas, comparar sus estadísticas y encontrar ideas para jugar. El filtro de cartas que te faltan ayuda a buscar mazos que puedas montar con tu colección.',
    imagen: 'radar-marvel-snap.png', ancho: 1790, alto: 908,
    alt: 'Radar Marvel Snap: filtros por cartas y arquetipos, mazos con sus estadísticas y acceso a sus fuentes.',
    pie: 'Menos búsquedas sueltas. Más combinaciones para probar.',
    enlace: 'https://robertocantero82.github.io/mazos_snap/', accion: 'Encontrar un mazo',
    detalle: 'Qué puedes hacer',
    puntos: ['Buscar cartas, mazos o arquetipos y ordenar los resultados.', 'Excluir las cartas que no tienes y copiar un mazo para probarlo.'],
    limite: 'Las estadísticas describen las partidas recogidas por las fuentes; no garantizan el resultado de tus partidas.',
  },
  {
    id: 'lofi', nombre: 'Nebula LoFi', tema: 'Música · Creación', estado: 'Canal público',
    titular: 'Ponle música a lo que estás haciendo.',
    descripcion: 'En Nebula también hay espacio para bajar el ritmo. Reúno música lofi y escenarios que acompañan las horas de estudio, trabajo o descanso. Puedes escuchar una sesión aquí o seguir explorando el canal.',
    imagen: 'nebula_lofi.jpg', ancho: 480, alto: 360,
    alt: 'Portada de la sesión de música de Nebula LoFi en YouTube.',
    pie: 'Una sesión de más de dos horas para encontrar tu ritmo.',
    enlace: 'https://www.youtube.com/@nebulalofimusica', accion: 'Ir al canal',
    detalle: 'Sobre la escucha',
    puntos: ['Cargar el reproductor y escuchar la sesión sin salir del Laboratorio.', 'Visitar YouTube para explorar el canal.'],
    limite: 'El reproductor de YouTube se carga únicamente cuando lo solicitas. La música no empieza al abrir esta página.',
  },
  {
    id: 'rebobina', nombre: 'Rebobina', tema: 'Cine de los 80 y 90 · Catálogo', estado: 'Proyecto local',
    titular: 'Vuelve al videoclub. Sin devolver la película el lunes.',
    descripcion: 'He preparado un catálogo de películas de 1980 a 1999 para redescubrir el cine con el que crecí. Puedo buscar títulos, recorrer los estrenos y organizar mi propia estantería con las que quiero ver o ya he visto.',
    imagen: 'rebobina.png', ancho: 1885, alto: 928,
    alt: 'Catálogo de Rebobina con filtros por título, año, mes y género y películas como Pulp Fiction, Matrix y Seven.',
    pie: 'Una captura del catálogo real. El proyecto todavía no tiene acceso público.',
    enlace: '/nebula/imagenes/laboratorio/rebobina.png', accion: 'Ampliar demostración',
    detalle: 'Qué incluye el catálogo',
    puntos: ['Filtros para explorar películas de 1980 a 1999.', 'Una estantería personal para organizar las películas pendientes y vistas.'],
    limite: 'La selección utiliza los votos actuales de IMDb como orientación de popularidad. No es un registro de lo más visto en aquellas décadas ni reproduce películas.',
  },
  {
    id: 'vhs-club', nombre: 'VHS Club', tema: 'Google TV · Aplicación', estado: 'En desarrollo',
    titular: 'Tus películas. Tus series. Tu propio videoclub.',
    descripcion: 'Estoy desarrollando una aplicación para Google TV que convertirá las películas y series de tu Google Drive en un videoclub de estética noventera. La idea: recorrer tu colección con el mando y reproducirla directamente en el televisor.',
    imagen: 'vhs_club_concepto.png', ancho: 1672, alto: 941,
    alt: 'Concepto visual de VHS Club: un videoclub de estilo noventero con un dependiente, estanterías de películas y luces de neón.',
    pie: 'Concepto visual del proyecto. No es una captura de una aplicación funcional.',
    enlace: undefined, accion: undefined,
    detalle: 'Qué estoy construyendo',
    puntos: ['Primera fase prevista: conectar Google Drive, organizar la colección y reproducir los archivos.', 'Navegación con el mando de Google TV y una ambientación de videoclub noventero.', 'Más adelante: seguimiento de películas y series, subtítulos y personalización.'],
    limite: 'El proyecto está en su fase inicial. Estas funciones están previstas; todavía no hay una versión disponible para descargar.',
  },
];

const otros = [
  { nombre: 'La NBA dibujada', tema: 'Datos y arte', imagen: 'la-nba-dibujada.png', alt: 'Un gráfico de partidos NBA se transforma en un cuadro de un perro viendo baloncesto.', descripcion: 'Convierto los datos de una jornada NBA en un gráfico y busco una figura en sus puntos. Con ayuda de la IA, esa figura se transforma en un cuadro.', enlace: 'https://x.com/lanbadibujada', accion: 'Ver los cuadros en X' },
  { nombre: 'Radar de empleo editorial', tema: 'Herramienta local', imagen: 'radar-empleo.png', alt: 'Búsquedas organizadas de empleo editorial en distintas redes sociales.', descripcion: 'Organizo búsquedas para encontrar ofertas de periodismo, redacción y edición en redes sociales desde un mismo lugar.', enlace: undefined, accion: undefined },
  { nombre: 'Agente de empleo editorial', tema: 'Automatización de uso personal', imagen: 'empleo-email.png', alt: 'Ejemplo de un boletín de ofertas de empleo seleccionadas por afinidad.', descripcion: 'Un agente que busca oportunidades, filtra su encaje con mi perfil y me envía una selección por correo, evitando repetir las ofertas.', enlace: undefined, accion: undefined },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/nebula/favicon.svg?v=5" />
    <meta name="theme-color" content="#1B1836" />
    <Seo titulo="Laboratorio | Nebula" descripcion="Explora mis proyectos de cine, NBA, Marvel Snap y música: Indy, Agente MVP, Radar Marvel Snap, Nebula LoFi, Rebobina y VHS Club, en desarrollo." />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera activa="laboratorio" />
    <main id="contenido" class="contenedor laboratorio">
      <header class="introduccion">
        <div>
          <p class="indice">LABORATORIO · ROBERTO CANTERO</p>
          <h1>Ideas que pongo<br />a trabajar.</h1>
          <p class="entradilla">Un cinéfilo con dudas, una jornada NBA pendiente y unas cuantas cartas por combinar.</p>
          <p class="presentacion">Creo herramientas y experiencias alrededor de las cosas que me gustan. Aquí puedes descubrirlas, probar las que tienen acceso público y echar un vistazo a lo que estoy construyendo.</p>
        </div>
        <nav class="indice-proyectos" aria-label="Explora los proyectos">
          <p class="indice">SEIS IDEAS EN MARCHA</p>
          {proyectos.map((proyecto, i) => (
            <a href={`#${proyecto.id}`}><span class="numero">{String(i + 1).padStart(2, '0')}</span><span>{proyecto.nombre}</span><span aria-hidden="true">↘</span></a>
          ))}
          <p class="nota-indice">4 públicos · 1 local · 1 en desarrollo</p>
        </nav>
      </header>

      <section class="coleccion" aria-label="Proyectos del Laboratorio">
        {proyectos.map((proyecto, i) => (
          <article id={proyecto.id} class:list={['proyecto', { 'proyecto-inverso': i % 2 === 1, 'proyecto-desarrollo': proyecto.id === 'vhs-club' }]} aria-labelledby={`titulo-${proyecto.id}`}>
            <div class="cabecera-proyecto">
              <p class="indice"><span class="numero">{String(i + 1).padStart(2, '0')}</span> / {proyecto.tema}</p>
              <p class:list={['estado', { 'estado-desarrollo': proyecto.id === 'vhs-club', 'estado-local': proyecto.id === 'rebobina' }]}>{proyecto.estado}</p>
            </div>
            <div class="cuerpo-proyecto">
              <figure class="visual">
                {proyecto.id === 'lofi' ? (
                  <div class="reproductor" data-lofi>
                    <button type="button" class="portada-lofi" data-cargar-lofi aria-label="Cargar el reproductor de Nebula LoFi" aria-describedby="aviso-lofi">
                      <img src="https://i.ytimg.com/vi/MXaqhtwawNs/hqdefault.jpg" alt={proyecto.alt} width={proyecto.ancho} height={proyecto.alto} loading="lazy" />
                      <span class="lofi-sombra" aria-hidden="true"></span>
                      <span class="lofi-etiqueta" aria-hidden="true">NEBULA LOFI · DALE UN RESPIRO AL DÍA</span>
                      <span class="lofi-play"><span aria-hidden="true">▶</span> Cargar reproductor</span>
                    </button>
                  </div>
                ) : (
                  <a class="ampliar" href={`/nebula/imagenes/laboratorio/${proyecto.imagen}`} target="_blank" rel="noopener noreferrer" aria-label={`Ampliar ${proyecto.id === 'vhs-club' ? 'concepto visual de' : 'captura de'} ${proyecto.nombre} (se abre en otra pestaña)`}>
                    <img src={`/nebula/imagenes/laboratorio/${proyecto.imagen}`} alt={proyecto.alt} width={proyecto.ancho} height={proyecto.alto} loading="lazy" />
                    <span class="ampliar-etiqueta" aria-hidden="true">{proyecto.id === 'vhs-club' ? 'VER EL CONCEPTO' : 'AMPLIAR CAPTURA'} ↗</span>
                  </a>
                )}
                <figcaption>{proyecto.pie}</figcaption>
              </figure>
              <div class="texto-proyecto">
                <h2 id={`titulo-${proyecto.id}`}>{proyecto.nombre}</h2>
                <p class="gancho">{proyecto.titular}</p>
                <p class="descripcion">{proyecto.descripcion}</p>
                {proyecto.enlace ? (
                  <a class="accion" href={proyecto.enlace} target="_blank" rel="noopener noreferrer">{proyecto.accion}<span aria-hidden="true">↗</span><span class="solo-lectores"> (se abre en otra pestaña)</span></a>
                ) : (
                  <p class="aviso-desarrollo">En desarrollo · Todavía no disponible para descargar.</p>
                )}
                <details class="detalle">
                  <summary>{proyecto.detalle}<span class="mas" aria-hidden="true">+</span></summary>
                  <ul>{proyecto.puntos.map(punto => <li>{punto}</li>)}</ul>
                  <p class="limite" id={proyecto.id === 'lofi' ? 'aviso-lofi' : undefined}>{proyecto.limite}</p>
                </details>
              </div>
            </div>
          </article>
        ))}
      </section>

      <details class="otros">
        <summary><span>Otros experimentos</span><span class="indice">03 PROYECTOS <span aria-hidden="true">+</span></span></summary>
        <p class="otros-intro">También construyo herramientas para buscar trabajo y explorar otras formas de contar historias con datos.</p>
        <div class="otros-grid">
          {otros.map(proyecto => (
            <article class="otro-proyecto">
              <p class="indice">{proyecto.tema}</p>
              <img src={`/nebula/imagenes/laboratorio/${proyecto.imagen}`} alt={proyecto.alt} loading="lazy" width="640" height="400" />
              <h3>{proyecto.nombre}</h3>
              <p>{proyecto.descripcion}</p>
              {proyecto.enlace ? <a class="accion" href={proyecto.enlace} target="_blank" rel="noopener noreferrer">{proyecto.accion} ↗<span class="solo-lectores"> (se abre en otra pestaña)</span></a> : <p class="indice">Uso personal · Sin acceso público</p>}
            </article>
          ))}
        </div>
        <section class="demostracion" aria-labelledby="titulo-demostracion">
        <div class="cabecera-proyectos">
          <div>
            <p class="indice">LA NBA DIBUJADA · UN EJEMPLO REAL</p>
            <h2 id="titulo-demostracion">Tres partidos. ¿Qué ves tú?</h2>
          </div>
        </div>
        <p class="explicacion">Cada punto es un partido de la jornada del 20 de octubre de 2026. De izquierda a derecha cambia la diferencia final entre los equipos; de abajo arriba, los puntos que sumaron entre los dos. A partir de esas posiciones busco una figura.</p>
        <div class="muestra">
          <figure>
            <svg viewBox="0 0 540 400" role="img" aria-labelledby="grafico-titulo grafico-descripcion">
              <title id="grafico-titulo">Tres partidos convertidos en puntos</title>
              <desc id="grafico-descripcion">Diferencia final y anotación conjunta, respectivamente: 8 y 234 puntos, 6 y 206, 12 y 220. Eje horizontal de 0 a 50; vertical de 150 a 280.</desc>
              <g fill="none" stroke="#D9D5C8">
                <path d="M70 50V310H490 M70 210H490 M70 110H490" />
              </g>
              <g fill="#6A6658" font-size="12" font-family="sans-serif">
                <text x="55" y="314" text-anchor="end">150</text><text x="55" y="214" text-anchor="end">200</text><text x="55" y="114" text-anchor="end">250</text><text x="55" y="54" text-anchor="end">280</text>
                <text x="70" y="335" text-anchor="middle">0</text><text x="154" y="335" text-anchor="middle">10</text><text x="238" y="335" text-anchor="middle">20</text><text x="322" y="335" text-anchor="middle">30</text><text x="406" y="335" text-anchor="middle">40</text><text x="490" y="335" text-anchor="middle">50</text>
                <text x="280" y="375" text-anchor="middle">Diferencia final (puntos)</text><text x="70" y="25">Puntos entre los dos equipos</text>
              </g>
              <g fill="#446ddf" stroke="#F7F5F0" stroke-width="2">
                <circle cx="137.2" cy="142" r="6" /><circle cx="120.4" cy="198" r="6" /><circle cx="170.8" cy="170" r="6" />
              </g>
            </svg>
            <figcaption>Primero, los datos. Sin mover los puntos para encajar la figura.</figcaption>
          </figure>
          <details>
            <summary>Descubrir el cuadro <span aria-hidden="true">↓</span></summary>
            <figure>
              <img src="/nebula/imagenes/laboratorio/velero-nba.png" width="1536" height="1024" loading="lazy" alt="Un velero con una pista de baloncesto en la cubierta navega por un pabellón imaginario inundado, con pinceladas azules y luces anaranjadas." />
              <figcaption>Yo vi un velero. Con ayuda de la IA, lo convertí en este cuadro. La escena es imaginaria.</figcaption>
            </figure>
          </details>
        </div>
      </section>
      </details>

      <aside class="autor" aria-labelledby="titulo-autor">
        <div><p class="indice">DETRÁS DEL LABORATORIO</p><h2 id="titulo-autor">Periodismo, datos y ganas de construir.</h2><p>Soy Roberto Cantero. Estas herramientas nacen de mis aficiones y de preguntas del día a día. Cada una es una forma de convertir lo que aprendo en algo que puedo utilizar y compartir.</p></div>
        <a class="accion" href="/nebula/trabaja-conmigo/">Más sobre mi trabajo <span aria-hidden="true">→</span></a>
      </aside>
    </main>
    <footer class="pie-pagina contenedor"><p>© {new Date().getFullYear()} Nebula | Roberto Cantero</p><p>Periodismo y ciencia de datos | <a href="/nebula/privacidad/">Privacidad</a></p></footer>
    <CloudflareAnalytics />
    <script>
      // cargo el reproductor únicamente después de una acción explícita
      document.addEventListener('click', (evento) => {
        const objetivo = evento.target;
        if (!(objetivo instanceof Element)) return;
        const boton = objetivo.closest<HTMLButtonElement>('[data-cargar-lofi]');
        const contenedor = boton?.closest<HTMLElement>('[data-lofi]');
        if (!boton || !contenedor) return;
        const musica = (window as Window & { __nebulaMusica?: { audio: HTMLAudioElement } }).__nebulaMusica;
        musica?.audio.pause();
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/MXaqhtwawNs?rel=0';
        iframe.title = 'Nebula LoFi: música para estudiar, trabajar y relajarte';
        iframe.allow = 'encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        contenedor.replaceChildren(iframe);
        iframe.focus();
      });
    </script>
  </body>
</html>

<style>
  .laboratorio { --azul: #446ddf; --azul-texto: #344f9b; }
  .indice, .numero, .estado, .accion, .nota-indice, .aviso-desarrollo, .ampliar-etiqueta, .lofi-etiqueta, .lofi-play, .detalle summary { font-family: var(--font-mono); }
  .indice { color: var(--color-secondary-text); font-size: 10px; line-height: 1.7; letter-spacing: .055em; text-transform: uppercase; }
  .introduccion { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; padding: clamp(3rem, 7vw, 5rem) 0 4rem; }
  h1 { font-size: clamp(3rem, 6.6vw, 5.6rem); line-height: .98; letter-spacing: -.04em; margin: 1.2rem 0 1.6rem; }
  .entradilla { font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.6; margin-bottom: 1rem; }
  .presentacion { color: var(--color-secondary-text); line-height: 1.8; font-size: .98rem; max-width: 560px; }
  .indice-proyectos { padding: 1.25rem 0 0 1.75rem; border-left: 1px solid var(--color-border); }
  .indice-proyectos > .indice { margin: 0 0 1rem; }
  .indice-proyectos a { display: grid; grid-template-columns: 2rem 1fr auto; align-items: center; gap: .7rem; border-top: 1px solid var(--color-border); min-height: 50px; text-decoration: none; font-size: 1.1rem; }
  .indice-proyectos a:hover { color: var(--azul-texto); }
  .numero { color: var(--azul-texto); font-size: 11px; }
  .nota-indice { color: var(--color-secondary-text); font-size: 9px; line-height: 1.8; margin: 1rem 0 0; }
  .proyecto { border-top: 1px solid var(--color-border); padding: 1.4rem 0 3.5rem; scroll-margin-top: 1.5rem; }
  .cabecera-proyecto { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .cabecera-proyecto p { margin: 0; }
  .cabecera-proyecto .numero { margin-right: .4rem; }
  .estado { display: inline-flex; align-items: center; gap: .45rem; font-size: 9px; line-height: 1.6; color: var(--azul-texto); border: 1px solid #cbd4ed; padding: .3rem .6rem; white-space: nowrap; }
  .estado::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .estado-local { color: #605d52; border-color: var(--color-border); }
  .estado-desarrollo { color: #8c421f; border-color: #ddc6b5; background: #f6ece2; }
  .cuerpo-proyecto { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .proyecto-inverso .cuerpo-proyecto { grid-template-columns: 1fr 1.25fr; }
  .proyecto-inverso .visual { order: 2; }
  .visual { margin: 0; min-width: 0; }
  .ampliar { display: block; position: relative; background: #efede6; border: 1px solid var(--color-border); overflow: hidden; }
  .ampliar img { display: block; width: 100%; height: auto; transition: transform .25s ease; }
  .ampliar:hover img { transform: scale(1.018); }
  .ampliar-etiqueta { display: block; color: var(--azul-texto); background: var(--color-bg); border-top: 1px solid var(--color-border); text-align: right; font-size: 9px; padding: .65rem .8rem; }
  figcaption { color: var(--color-secondary-text); font-size: .76rem; line-height: 1.6; margin: .7rem 0 0; }
  .texto-proyecto { min-width: 0; }
  .texto-proyecto h2 { font-size: clamp(2rem, 3.5vw, 3rem); line-height: 1.02; letter-spacing: -.025em; margin: -.1rem 0 1rem; }
  .gancho { font-size: clamp(1.1rem, 1.6vw, 1.25rem); line-height: 1.5; margin: 0 0 1rem; font-weight: 700; }
  .descripcion { font-size: .95rem; line-height: 1.8; margin: 0 0 1.25rem; }
  .accion { display: inline-flex; gap: 1rem; align-items: center; min-height: 44px; color: var(--azul-texto); font-size: 11px; line-height: 1.6; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .accion:hover { color: var(--color-ink); }
  .detalle { border-top: 1px solid var(--color-border); margin-top: 1.3rem; }
  .detalle summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 0; min-height: 44px; cursor: pointer; font-size: 10px; color: var(--azul-texto); list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .mas { font-size: 18px; line-height: 1; }
