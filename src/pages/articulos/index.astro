---
import { getCollection } from 'astro:content';import '../../styles/global.css';import Seo from '../../components/Seo.astro';import Cabecera from '../../components/Cabecera.astro';import CloudflareAnalytics from '../../components/CloudflareAnalytics.astro';
const ahora=new Date();const articulos=(await getCollection('articulos')).filter(a=>a.data.fecha<=ahora&&a.data.serie!=='trama').sort((a,b)=>b.data.fecha.getTime()-a.data.fecha.getTime());const fecha=(f:Date)=>new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long',year:'numeric'}).format(f);
---
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="icon" type="image/svg+xml" href="/nebula/favicon.svg?v=2"/><Seo titulo="Análisis | Nebula" descripcion="Archivo de análisis de datos de Nebula sobre ciencia, tecnología, sociedad, cultura y deporte."/></head><body><Cabecera activa="analisis"/><main class="contenedor archivo"><header><p>ARCHIVO</p><h1>Todos los análisis</h1><span>{articulos.length} historias construidas con datos, fuentes y una pregunta clara.</span></header><div class="grid-articulos">{articulos.map(a=><a class="tarjeta-articulo" href={`/nebula/articulos/${a.id}/`}><div class="tarjeta-imagen">{a.data.imagenPortada&&<img src={a.data.imagenPortada} alt="" loading="lazy"/>}</div><article><div class="tarjeta-meta"><span>{a.data.tema}</span><time datetime={a.data.fecha.toISOString()}>{fecha(a.data.fecha)}</time></div><h2>{a.data.titulo}</h2>{a.data.cifraDestacada&&<div class="tarjeta-dato"><strong>{a.data.cifraDestacada}</strong><span>{a.data.etiquetaCifra}</span></div>}</article></a>)}</div></main><footer class="pie-pagina contenedor"><p>© {new Date().getFullYear()} Nebula | Roberto Cantero</p><p><a href="/nebula/privacidad/">Privacidad</a></p></footer><CloudflareAnalytics/></body></html>
<style>.archivo{padding-bottom:6rem;padding-top:clamp(3rem,8vw,6rem)}.archivo>header{border-bottom:1px solid var(--color-border);margin-bottom:2.5rem;padding-bottom:2.5rem}.archivo>header p{color:var(--color-accent);font:11px var(--font-mono);letter-spacing:.09em;margin:0}.archivo h1{font-size:clamp(3rem,8vw,6.5rem);line-height:.9;margin:1rem 0}.archivo>header span{color:var(--color-secondary-text);font-size:1.05rem}.tarjeta-articulo h2{font-size:clamp(1.35rem,2.3vw,1.85rem);line-height:1.15;margin:1rem 0 1.5rem}</style>
