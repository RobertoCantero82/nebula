---
import { getCollection, render } from 'astro:content';
import Articulo from '../../layouts/Articulo.astro';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  const mezclar = <T,>(elementos: T[]) => {
    const resultado = [...elementos];
    for (let indice = resultado.length - 1; indice > 0; indice -= 1) {
      const posicion = Math.floor(Math.random() * (indice + 1));
      [resultado[indice], resultado[posicion]] = [resultado[posicion], resultado[indice]];
    }
    return resultado;
  };

  return articulos.map((articulo) => ({
    params: { slug: articulo.id },
    props: {
      articulo,
      relacionados: mezclar(
        articulos.filter((candidato) =>
          candidato.id !== articulo.id && candidato.data.tema === articulo.data.tema
        )
      ).slice(0, 3),
    },
  }));
}

const { articulo, relacionados } = Astro.props;
const { Content } = await render(articulo);
---

<Articulo
  titulo={articulo.data.titulo}
  descripcion={articulo.data.descripcion}
  tema={articulo.data.tema}
  fecha={articulo.data.fecha}
  cifraDestacada={articulo.data.cifraDestacada}
  etiquetaCifra={articulo.data.etiquetaCifra}
  metodologia={articulo.data.metodologia}
  imagenPortada={articulo.data.imagenPortada}
  relacionados={relacionados}
>
  <Content />
</Articulo>
