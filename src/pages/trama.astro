---
import { getCollection } from 'astro:content';import '../styles/global.css';import Seo from '../components/Seo.astro';import Cabecera from '../components/Cabecera.astro';import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
const ahora=new Date();const entregas=(await getCollection('articulos')).filter(a=>a.data.fecha<=ahora&&a.data.serie==='trama').sort((a,b)=>b.data.fecha.getTime()-a.data.fecha.getTime());
---
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="icon" type="image/svg+xml" href="/nebula/favicon.svg?v=2"/><Seo titulo="Trama | Nebula" descripcion="Dos películas que parecen no tener nada en común. Los datos, los créditos y la pantalla encuentran la conexión." imagen={entregas[0]?.data.imagenPortada}/></head><body><Cabecera activa="trama"/><main><section class="trama-hero contenedor"><p>CINE | TRAMA</p><h1>Todo el cine está conectado. Solo hay que encontrar el hilo.</h1><span>En cada entrega elijo dos películas aparentemente alejadas. Después utilizo valoraciones, géneros, etiquetas, créditos y detalles de la pantalla para comprobar dónde se cruzan.</span></section><section class="contenedor entregas" aria-labelledby="titulo-entregas"><div class="cabecera-seccion"><div><p class="indice-seccion">TODAS LAS ENTREGAS</p><h2 id="titulo-entregas">Las conexiones encontradas</h2></div><p>{entregas.length} {entregas.length===1?'historia publicada':'historias publicadas'}</p></div><div class="grid-articulos">{entregas.map((a,i)=><a class="tarjeta-articulo" href={`/nebula/articulos/${a.id}/`}><div class="tarjeta-imagen">{a.data.imagenPortada&&<img src={a.data.imagenPortada} alt=""/>}</div><article><div class="tarjeta-meta"><span>TRAMA | ENTREGA {entregas.length-i}</span></div><h3>{a.data.titulo}</h3><p>{a.data.descripcion}</p></article></a>)}</div></section></main><footer class="pie-pagina contenedor"><p>© {new Date().getFullYear()} Nebula | Roberto Cantero</p><p><a href="/nebula/privacidad/">Privacidad</a></p></footer><CloudflareAnalytics/></body></html>
<style>.trama-hero{padding-bottom:clamp(4rem,9vw,7rem);padding-top:clamp(4rem,10vw,8rem)}.trama-hero>p{color:var(--color-accent);font:11px var(--font-mono);letter-spacing:.1em;margin:0}.trama-hero h1{font-size:clamp(3rem,8vw,7rem);letter-spacing:-.035em;line-height:.88;margin:1.25rem 0 2rem;max-width:950px}.trama-hero>span{color:var(--color-secondary-text);display:block;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.65;max-width:760px}.entregas{padding-bottom:7rem}.tarjeta-articulo article>p{color:var(--color-secondary-text);line-height:1.5;margin:0}</style>
