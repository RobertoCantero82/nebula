---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Cabecera from '../components/Cabecera.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';

const ejemplos = [
  { tema: 'CINE', titulo: "¿Llegará 'La bola negra' a los Oscar?", ruta: 'articulo_la_bola_negra_oscar', imagen: 'bolanegra_portada.png' },
  { tema: 'MOVILIDAD ELÉCTRICA', titulo: 'Tesla ganó septiembre. BYD puede quedarse con todo el año', ruta: 'byd-adelanta-tesla-electricos-puros-2026', imagen: 'byd_tesla_electricos_portada.png' },
  { tema: 'TECNOLOGÍA', titulo: '¿Es el iPhone Duo un móvil o un iPad mini plegable?', ruta: 'iphone-duo-ipad-mini', imagen: 'iphone_duo_portada.png' },
  { tema: 'BALONCESTO', titulo: 'Los 10 récords NBA que el machine learning ve más cerca de romperse', ruta: 'records-nba-predicciones-locas-2026-27', imagen: 'records_nba_portada.png' },
];
---
<html lang="es">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <link rel="icon" type="image/svg+xml" href="/nebula/favicon.svg?v=5"/>
  <Seo titulo="Colabora con Nebula" descripcion="Pruebas de producto, historias con datos y colaboraciones editoriales independientes sobre tecnología, ciencia, cine y movilidad eléctrica."/>
</head>
<body>
<Cabecera activa="colabora"/>
<main>
  <section class="hero contenedor">
    <div><p class="etiqueta">COLABORA CON NEBULA</p><h1>Tu producto puede contar algo más que sus especificaciones.</h1></div>
    <div class="hero-bajada"><p>En Nebula lo probamos, lo medimos y buscamos la historia que esconden sus datos. Colaboramos con empresas que quieren explicar la tecnología, la ciencia, el cine y la movilidad de una forma clara, rigurosa y cercana.</p><a class="boton" href="#propuesta">Cuéntame tu propuesta <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="formatos contenedor" aria-labelledby="formatos-titulo">
    <header><p class="etiqueta">TRES FORMAS DE COLABORAR</p><h2 id="formatos-titulo">Cada propuesta pide una historia distinta</h2></header>
    <div class="formatos-grid">
      <article><span>01</span><h3>Prueba Nebula</h3><p>Una prueba real de un producto o servicio. No nos quedamos en la ficha técnica: observamos cómo funciona, medimos lo que aporta y contamos la experiencia con contexto.</p><small>Cesión temporal o permanente · Servicios · Afiliación</small></article>
      <article><span>02</span><h3>Historia con datos</h3><p>Una pregunta relevante para la empresa y para el lector, respondida mediante datos, fuentes comprobables y una narración sencilla. La empresa apoya; Nebula conserva el análisis.</p><small>Patrocinio identificado · Metodología independiente</small></article>
      <article><span>03</span><h3>Serie Nebula</h3><p>Varias piezas conectadas para explorar un tema con más profundidad. El número de entregas, el formato y la duración se diseñan para cada proyecto.</p><small>Web · LinkedIn · Vídeo cuando encaja</small></article>
    </div>
  </section>

  <section class="prueba">
    <div class="contenedor prueba-grid"><div><p class="etiqueta">CÓMO FUNCIONA UNA PRUEBA</p><h2>Del producto a la pregunta que merece la pena responder</h2></div>
    <ol><li><span>01</span><div><h3>Encaje editorial</h3><p>Valoramos si la propuesta puede interesar a la comunidad de Nebula. No se deben enviar productos sin haber acordado antes la colaboración.</p></div></li><li><span>02</span><div><h3>Uso en condiciones reales</h3><p>La duración depende del producto: pueden ser unas horas, varios días o el tiempo necesario para comprenderlo bien.</p></div></li><li><span>03</span><div><h3>Publicación garantizada</h3><p>Si aceptamos la prueba, habrá publicación. Su extensión dependerá de lo que el producto o servicio permita contar.</p></div></li><li><span>04</span><div><h3>Origen visible</h3><p>Indicamos si el producto ha sido comprado por Nebula o proporcionado por la empresa. La marca no interviene en las conclusiones.</p></div></li></ol></div>
  </section>

  <section class="principio contenedor"><p class="etiqueta">EL COMPROMISO</p><blockquote>“Independencia no significa confrontación.”</blockquote><p>Nebula analiza cada producto y cada historia con honestidad, respeto y voluntad de aportar. Si encontramos algo mejorable, buscamos entenderlo, contextualizarlo y explicarlo de forma útil.</p></section>

  <section class="ejemplos contenedor" aria-labelledby="ejemplos-titulo"><header><div><p class="etiqueta">EL TONO, EN LA PRÁCTICA</p><h2 id="ejemplos-titulo">Historias que ya cuentan cómo trabaja Nebula</h2></div><p>Estos artículos son ejemplos editoriales y no fueron colaboraciones patrocinadas.</p></header><div class="ejemplos-grid">{ejemplos.map(e => <a href={`/nebula/articulos/${e.ruta}/`}><img src={`/nebula/imagenes/${e.imagen}`} alt="" loading="lazy"/><span>{e.tema}</span><h3>{e.titulo}</h3><small>Leer el artículo →</small></a>)}</div></section>

  <section class="oportunidades"><div class="contenedor"><p class="etiqueta">AHORA MISMO</p><h2>Buscamos colaboraciones que empiecen por probar y aprender</h2><div class="oportunidades-grid"><article><h3>Productos y vehículos</h3><p>Cesiones para pruebas, especialmente en tecnología y movilidad eléctrica.</p></article><article><h3>Servicios y aplicaciones</h3><p>Acceso suficiente para utilizarlos de verdad y analizar su propuesta.</p></article><article><h3>Afiliación</h3><p>Solo sobre productos o servicios analizados y con aviso transparente.</p></article><article><h3>Sorteos</h3><p>Como complemento opcional de una prueba. La empresa aporta una unidad adicional y la envía directamente a la persona ganadora.</p></article></div><p class="futuro">También estudiamos historias con datos y series patrocinadas cuando existe un encaje editorial claro.</p></div></section>

  <section class="audiencia contenedor" aria-labelledby="audiencia-titulo"><div><p class="etiqueta">LA COMUNIDAD DE NEBULA, EN DATOS</p><h2 id="audiencia-titulo">Una audiencia pequeña que empieza a crecer</h2><p>Cifras verificadas con Cloudflare Web Analytics, con bots excluidos. El primer corte se realizó el 7 de noviembre de 2026.</p><div class="periodos" role="group" aria-label="Periodo de audiencia"><button class="activo" data-periodo="30">30 días</button><button data-periodo="90">3 meses</button><button data-periodo="365">12 meses</button></div><p class="estado-periodo" aria-live="polite">Datos disponibles de los últimos 30 días.</p></div><div class="audiencia-datos" data-audiencia><article><strong>90</strong><span>visitas</span></article><article><strong>110</strong><span>páginas vistas</span></article><article><strong>78 %</strong><span>de las visitas desde España</span></article><article><strong>40 / 30 / 20</strong><span>escritorio · tableta · móvil</span></article><small>Fuente: Cloudflare Web Analytics · 9 de octubre–7 de noviembre de 2026</small></div></section>

  <section class="reglas contenedor"><header><p class="etiqueta">ANTES DE ESCRIBIR</p><h2>Lo esencial, sin letra pequeña</h2></header><div class="reglas-grid"><p>Enviar una propuesta no garantiza que sea aceptada. Nebula selecciona solo aquello que encaja con sus temas y lectores.</p><p>Una colaboración aceptada sí tendrá publicación, aunque el formato y la extensión dependerán de la prueba.</p><p>La marca puede comprobar un dato técnico puntual, pero no aprobar ni modificar las conclusiones.</p><p>Compartir o enlazar la publicación es libre. Su reutilización publicitaria o comercial requiere permiso.</p><p>Los gastos extraordinarios de desplazamiento, alojamiento, recarga o entrada se acuerdan antes de empezar.</p><p>Las condiciones de devolución, conservación o envío se fijan por escrito para cada producto.</p></div></section>

  <section class="contacto" id="propuesta"><div class="contenedor contacto-grid"><div><p class="etiqueta">HABLEMOS</p><h2>¿Qué historia podría contar tu producto?</h2><p>Describe la propuesta con el contexto necesario. No envíes ningún producto hasta que acordemos la colaboración y la dirección de entrega.</p><p class="correo">Propuestas comerciales: <a href="mailto:robertocanterogomez@gmail.com">robertocanterogomez@gmail.com</a></p></div>
  <form id="form-colabora">
    <label>Nombre<input name="nombre" required autocomplete="name"/></label>
    <label>Empresa<input name="empresa" required autocomplete="organization"/></label>
    <label>Correo electrónico<input name="email" type="email" required autocomplete="email"/></label>
    <label>Producto, servicio o proyecto<input name="proyecto" required/></label>
    <label>Tipo de colaboración<select name="tipo" required><option value="">Selecciona una opción</option><option>Cesión de producto</option><option>Prueba de servicio</option><option>Historia con datos</option><option>Patrocinio de una serie</option><option>Afiliación</option><option>Otra propuesta</option></select></label>
    <label class="ancho">Mensaje<textarea name="mensaje" rows="6" required></textarea></label>
    <label class="privacidad ancho"><input name="privacidad" type="checkbox" required/> <span>He leído la <a href="/nebula/privacidad/">política de privacidad</a> y acepto que mis datos se utilicen para responder a esta propuesta.</span></label>
    <button class="ancho" type="submit">Preparar correo <span aria-hidden="true">→</span></button><p class="nota ancho">Al pulsar se abrirá tu aplicación de correo con la propuesta preparada. Podrás revisarla antes de enviarla.</p>
  </form></div></section>

  <section class="faq contenedor"><header><p class="etiqueta">PREGUNTAS FRECUENTES</p><h2>Cuatro respuestas rápidas</h2></header><details><summary>¿Nebula acepta cualquier producto?</summary><p>No. Debe encajar con tecnología, ciencia, cine, movilidad eléctrica o con una historia que pueda abordarse mediante datos.</p></details><details><summary>¿La empresa puede revisar el artículo?</summary><p>Puede ayudar a comprobar un dato técnico puntual cuando sea necesario, pero no intervenir en las conclusiones ni aprobar la publicación.</p></details><details><summary>¿Cuánto dura una prueba?</summary><p>Se acuerda en cada caso. Un producto sencillo puede necesitar horas; un vehículo, una aplicación o un servicio pueden requerir varios días.</p></details><details><summary>¿Qué ocurre con el producto después?</summary><p>La devolución o conservación se acuerda antes de la cesión. Si debe volver, se concretan el plazo y la logística por escrito.</p></details></section>
</main>
<footer class="pie-pagina contenedor"><p>© {new Date().getFullYear()} Nebula | Roberto Cantero</p><p><a href="/nebula/privacidad/">Privacidad</a></p></footer><CloudflareAnalytics/>
<script>
  document.querySelector('#form-colabora')?.addEventListener('submit', (evento) => {
    evento.preventDefault(); const form = new FormData(evento.currentTarget as HTMLFormElement);
    const asunto = `Propuesta para Nebula: ${form.get('empresa')} · ${form.get('tipo')}`;
    const cuerpo = [`Nombre: ${form.get('nombre')}`, `Empresa: ${form.get('empresa')}`, `Correo: ${form.get('email')}`, `Producto, servicio o proyecto: ${form.get('proyecto')}`, `Tipo de colaboración: ${form.get('tipo')}`, '', String(form.get('mensaje'))].join('\n');
    window.location.href = `mailto:robertocanterogomez@gmail.com?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
  });
  const botonesPeriodo = [...document.querySelectorAll<HTMLButtonElement>('[data-periodo]')];
  const datosAudiencia = document.querySelector<HTMLElement>('[data-audiencia]');
  const estadoPeriodo = document.querySelector<HTMLElement>('.estado-periodo');
  botonesPeriodo.forEach((boton) => boton.addEventListener('click', () => {
    botonesPeriodo.forEach((item) => item.classList.toggle('activo', item === boton));
    const disponible = boton.dataset.periodo === '30';
    datosAudiencia?.classList.toggle('sin-historico', !disponible);
    if (estadoPeriodo) estadoPeriodo.textContent = disponible
      ? 'Datos disponibles de los últimos 30 días.'
      : 'Todavía no existe un histórico verificado para este periodo. Lo construiremos con cortes mensuales.';
  }));
</script>
</body></html>
<style>
.etiqueta{color:var(--color-accent);font:11px var(--font-mono);letter-spacing:.09em;margin:0}.hero{display:grid;gap:clamp(2rem,7vw,7rem);grid-template-columns:1.4fr .6fr;padding-bottom:clamp(5rem,10vw,8rem);padding-top:clamp(5rem,10vw,8rem)}.hero h1{font-size:clamp(3.2rem,7vw,6.8rem);letter-spacing:-.045em;line-height:.88;margin:1.2rem 0 0}.hero-bajada{align-self:end}.hero-bajada p{color:var(--color-secondary-text);font-size:1.08rem;line-height:1.7}.boton{background:var(--color-ink);color:#fff;display:inline-flex;font:600 11px var(--font-mono);gap:1rem;margin-top:1rem;padding:1rem 1.2rem;text-decoration:none}.formatos,.ejemplos,.reglas,.faq{border-top:1px solid var(--color-border);padding-bottom:clamp(5rem,9vw,8rem);padding-top:clamp(5rem,9vw,8rem)}.formatos header,.reglas header,.faq header{display:grid;gap:2rem;grid-template-columns:.55fr 1.45fr;margin-bottom:3rem}.formatos h2,.ejemplos h2,.reglas h2,.faq h2,.audiencia h2{font-size:clamp(2.3rem,5vw,4.2rem);line-height:1;margin:0}.formatos-grid{display:grid;grid-template-columns:repeat(3,1fr)}.formatos-grid article{border-left:1px solid var(--color-border);padding:clamp(1.4rem,3vw,2.2rem)}.formatos-grid article>span{color:var(--color-accent);font:10px var(--font-mono)}.formatos-grid h3{font-size:1.8rem;margin:3rem 0 1rem}.formatos-grid p{line-height:1.65}.formatos-grid small{color:var(--color-secondary-text);display:block;font:10px/1.6 var(--font-mono);margin-top:2rem}.prueba,.oportunidades,.contacto{background:var(--color-ink);color:#fff;padding:clamp(5rem,9vw,8rem) 0}.prueba-grid{display:grid;gap:clamp(3rem,8vw,7rem);grid-template-columns:.85fr 1.15fr}.prueba h2,.oportunidades h2,.contacto h2{font-size:clamp(2.5rem,5vw,4.4rem);line-height:1;margin:1rem 0}.prueba ol{list-style:none;margin:0;padding:0}.prueba li{border-top:1px solid rgb(255 255 255 / 20%);display:grid;gap:1.5rem;grid-template-columns:40px 1fr;padding:1.4rem 0}.prueba li>span{color:var(--color-accent);font:10px var(--font-mono)}.prueba h3{font-size:1.35rem;margin:0}.prueba li p{color:#d8d5e5;line-height:1.55;margin:.45rem 0 0}.principio{padding-bottom:clamp(5rem,10vw,9rem);padding-top:clamp(5rem,10vw,9rem);text-align:center}.principio blockquote{font:600 clamp(2.8rem,7vw,6.5rem)/.95 var(--font-heading);letter-spacing:-.04em;margin:2rem auto;max-width:900px}.principio>p:last-child{color:var(--color-secondary-text);font-size:1.1rem;line-height:1.7;margin:0 auto;max-width:720px}.ejemplos header{align-items:end;display:grid;gap:3rem;grid-template-columns:1.5fr .5fr;margin-bottom:3rem}.ejemplos header h2{margin-top:1rem}.ejemplos header>p{color:var(--color-secondary-text);line-height:1.55}.ejemplos-grid{display:grid;gap:1.5rem;grid-template-columns:repeat(2,1fr)}.ejemplos-grid a{border:1px solid var(--color-border);padding:1rem;text-decoration:none}.ejemplos-grid img{aspect-ratio:16/8;object-fit:cover;width:100%}.ejemplos-grid span{color:var(--color-accent);display:block;font:10px var(--font-mono);margin-top:1.2rem}.ejemplos-grid h3{font-size:1.7rem;margin:.65rem 0 1.5rem}.ejemplos-grid small{font:10px var(--font-mono)}.oportunidades h2{max-width:800px}.oportunidades-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:3rem}.oportunidades-grid article{border-left:1px solid rgb(255 255 255 / 20%);padding:1.5rem}.oportunidades-grid p,.futuro,.contacto p{color:#d8d5e5;line-height:1.6}.futuro{border-top:1px solid rgb(255 255 255 / 20%);margin:2rem 0 0;padding-top:2rem}.audiencia{display:grid;gap:clamp(2rem,7vw,6rem);grid-template-columns:1.2fr .8fr;padding-bottom:clamp(5rem,9vw,8rem);padding-top:clamp(5rem,9vw,8rem)}.audiencia h2{margin:1rem 0}.audiencia>div>p:last-child{color:var(--color-secondary-text);line-height:1.6}.audiencia-pendiente{background:#fff;border:1px solid var(--color-border);padding:2rem}.audiencia-pendiente>span{color:var(--color-accent);font-size:2rem}.audiencia-pendiente strong{display:block;font:600 1.6rem var(--font-heading);margin:2rem 0 .5rem}.reglas-grid{display:grid;grid-template-columns:repeat(2,1fr)}.reglas-grid p{border-left:2px solid var(--color-accent);line-height:1.65;margin:0;padding:1.2rem 2rem}.contacto-grid{display:grid;gap:clamp(3rem,8vw,7rem);grid-template-columns:.7fr 1.3fr}.correo{font-size:.9rem}.contacto form{display:grid;gap:1rem;grid-template-columns:repeat(2,1fr)}.contacto label{color:#d8d5e5;font:10px var(--font-mono)}.contacto input,.contacto select,.contacto textarea{background:#fff;border:0;border-radius:0;color:var(--color-ink);display:block;font:16px var(--font-body);margin-top:.5rem;padding:.9rem;width:100%}.contacto .ancho{grid-column:1/-1}.privacidad{align-items:flex-start;display:flex;gap:.7rem;line-height:1.5}.privacidad input{margin:.1rem 0 0;width:auto}.contacto button{background:var(--color-accent);border:0;color:#fff;cursor:pointer;font:600 11px var(--font-mono);padding:1rem;text-align:left}.nota{color:#aaa6bb!important;font:10px/1.5 var(--font-mono);margin:0}.faq details{border-top:1px solid var(--color-border);padding:1.4rem 0}.faq summary{cursor:pointer;font:600 1.35rem var(--font-heading)}.faq details p{color:var(--color-secondary-text);line-height:1.6;max-width:760px}.pie-pagina{border-top:1px solid var(--color-border);display:flex;justify-content:space-between;padding-bottom:2rem;padding-top:2rem;font:10px var(--font-mono)}
.audiencia{grid-template-columns:1fr 1fr}.audiencia>div>p{color:var(--color-secondary-text);line-height:1.6}.periodos{display:flex;gap:.5rem;margin-top:2rem}.periodos button{background:transparent;border:1px solid var(--color-border);color:var(--color-ink);cursor:pointer;font:10px var(--font-mono);padding:.65rem .8rem}.periodos button.activo{background:var(--color-ink);border-color:var(--color-ink);color:#fff}.estado-periodo{font:10px/1.5 var(--font-mono);min-height:3em}.audiencia-datos{background:#fff;border:1px solid var(--color-border);display:grid;grid-template-columns:repeat(2,1fr);padding:1.5rem;transition:opacity .2s ease}.audiencia-datos article{border-left:2px solid var(--color-accent);padding:1rem}.audiencia-datos strong{display:block;font:600 clamp(2rem,5vw,3.4rem) var(--font-heading)}.audiencia-datos span{color:var(--color-secondary-text);font-size:.85rem}.audiencia-datos small{color:var(--color-secondary-text);font:9px var(--font-mono);grid-column:1/-1;margin:1rem}.audiencia-datos.sin-historico{opacity:.18}
@media(max-width:900px){.hero,.prueba-grid,.audiencia,.contacto-grid{grid-template-columns:1fr}.formatos-grid,.oportunidades-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.formatos header,.reglas header,.faq header,.ejemplos header{grid-template-columns:1fr}.formatos-grid,.ejemplos-grid,.oportunidades-grid,.reglas-grid,.contacto form{grid-template-columns:1fr}.formatos-grid article,.oportunidades-grid article{border-top:1px solid var(--color-border)}.contacto .ancho{grid-column:auto}.hero h1{font-size:clamp(2.65rem,12.5vw,4rem);line-height:.93;overflow-wrap:anywhere}.audiencia-datos{grid-template-columns:1fr}}
</style>
