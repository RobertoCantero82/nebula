---
import { getCollection } from 'astro:content';
import Actualidad from '../../layouts/Actualidad.astro';
import HazloFacil from '../../layouts/HazloFacil.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const piezas = await getCollection('actualidad');

  return piezas.map((pieza) => ({
    params: { slug: pieza.id },
    props: { pieza },
  }));
}

const { pieza } = Astro.props;
const esGuia = pieza.data.categoria === 'hazlo-facil';
const contenido = esGuia ? await render(pieza) : undefined;
const Content = contenido?.Content;
---

<>{esGuia ? <HazloFacil pieza={pieza}>{Content && <Content />}</HazloFacil> : <Actualidad pieza={pieza} />}</>
