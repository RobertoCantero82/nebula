---
import { getCollection } from 'astro:content';
import { fechaPublicacion, estaPublicada } from '../../utils/publicacion';
import '../../styles/global.css';
import RelojActualidad from '../../components/RelojActualidad.astro';
import Seo from '../../components/Seo.astro';
import Cabecera from '../../components/Cabecera.astro';
import CloudflareAnalytics from '../../components/CloudflareAnalytics.astro';

// elijo una palabra del titular y conservo el texto original completo
const fragmentarTitular = (titulo: string, palabraDestacada?: string) => {
  const palabras = [...titulo.matchAll(/[\p{L}\p{N}]+(?:[-’'][\p{L}\p{N}]+)*/gu)];
  if (palabraDestacada !== undefined) {
    const seleccion = palabraDestacada.trim();
    if (!seleccion) return { antes: titulo, palabra: '', despues: '' };
    const literal = seleccion.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const elegida = new RegExp('(?<![\\p{L}\\p{N}_])' + literal + '(?![\\p{L}\\p{N}_])', 'iu').exec(titulo);
    if (!elegida) return { antes: titulo, palabra: '', despues: '' };
    const inicio = elegida.index!;
    return { antes: titulo.slice(0, inicio), palabra: elegida[0], despues: titulo.slice(inicio + elegida[0].length) };
  }
  const preferidas = ['Kodak', 'Neptuno', 'Marvel', 'Marianas', 'Voyager', 'Tesla', 'Matrix', 'átomo'];
  const elegida = preferidas.map(palabra => palabras.find(p => p[0].toLocaleLowerCase('es') === palabra.toLocaleLowerCase('es'))).find(Boolean)
    ?? palabras.filter(p => /\p{L}/u.test(p[0])).sort((a, b) => b[0].length - a[0].length)[0];
  if (!elegida) return { antes: titulo, palabra: '', despues: '' };
  const inicio = elegida.index!;
  return { antes: titulo.slice(0, inicio), palabra: elegida[0], despues: titulo.slice(inicio + elegida[0].length) };
};

const ahora = new Date();
const piezas = (await getCollection('actualidad'))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const grupos = Object.entries(Object.groupBy(piezas, (pieza) => pieza.data.fecha.toISOString().slice(0, 10)));
const fecha = (valor: Date) => new Intl.DateTimeFormat('es-ES', {
  timeZone: 'Europe/Madrid',
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(valor);
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <Seo titulo="Archivo de actualidad | Nebula" descripcion="Las noticias breves de ciencia, tecnología, cine y cultura publicadas en Nebula." />
  </head>
  <body>
    <Cabecera activa="actualidad" />
    <main class="contenedor archivo-actualidad">
      <header>
        <p>ARCHIVO</p>
        <h1>Actualidad</h1>
        <span data-total-noticias>{piezas.filter(p => estaPublicada(p.data, ahora)).length} noticias breves publicadas en Nebula.</span>
      </header>
      {grupos.map(([, publicaciones]) => publicaciones && publicaciones.length > 0 && (
        <section hidden={!publicaciones.some(p => estaPublicada(p.data, ahora))} class="dia-actualidad" aria-labelledby={`dia-${publicaciones[0].data.fecha.toISOString().slice(0, 10)}`}>
          <h2 id={`dia-${publicaciones[0].data.fecha.toISOString().slice(0, 10)}`}>{fecha(publicaciones[0].data.fecha)}</h2>
          <div>
            {publicaciones.map((pieza) => (
              <a data-publicar={fechaPublicacion(pieza.data).getTime()} hidden={!estaPublicada(pieza.data, ahora)} href={`/actualidad/${pieza.id}/`}>
                <span>{pieza.data.categoria}</span>
                <h3>{(() => { const { antes, palabra, despues } = fragmentarTitular(pieza.data.titulo, pieza.data.palabraDestacada); return <>{antes}<span class="actualidad-palabra">{palabra}</span>{despues}</>; })()}</h3>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>
    <footer class="pie-pagina contenedor"><p>© {new Date().getFullYear()} Nebula | Roberto Cantero</p><p><a href="/privacidad/">Privacidad</a></p></footer>
    <CloudflareAnalytics /><RelojActualidad />
  </body>
</html>

<style>
  .archivo-actualidad{padding-bottom:6rem;padding-top:clamp(3rem,8vw,6rem)}
  .archivo-actualidad>header{border-bottom:1px solid var(--color-border);margin-bottom:2.5rem;padding-bottom:2.5rem}
  .archivo-actualidad>header p{color:var(--color-accent);font:11px var(--font-mono);letter-spacing:.09em;margin:0}
  .archivo-actualidad h1{font-size:clamp(3rem,8vw,6.5rem);line-height:.9;margin:1rem 0}
  .archivo-actualidad>header span{color:var(--color-secondary-text);font-size:1.05rem}
  .dia-actualidad{border-bottom:1px solid var(--color-border);display:grid;gap:clamp(1.5rem,4vw,4rem);grid-template-columns:minmax(180px,.6fr) minmax(0,2fr);padding:2rem 0}
  .dia-actualidad h2{font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.2;margin:0;text-transform:capitalize}
  .dia-actualidad>div{display:grid}
  .dia-actualidad a{align-items:center;border-top:1px solid var(--color-border);display:grid;gap:1.25rem;grid-template-columns:90px minmax(0,1fr);padding:1rem 0;text-decoration:none}
  .dia-actualidad a:first-child{border-top:0;padding-top:0}
  .dia-actualidad a>span{color:#446ddf;font:600 10px var(--font-mono);text-transform:uppercase}
  .actualidad-palabra{color:#446ddf}
  .dia-actualidad a:focus-visible{outline:2px solid #446ddf;outline-offset:4px}
  .dia-actualidad h3{font-size:clamp(1rem,1.7vw,1.3rem);line-height:1.2;margin:0}
  @media(max-width:700px){.dia-actualidad{grid-template-columns:1fr}.dia-actualidad a{grid-template-columns:1fr;gap:.5rem}}
</style>
