---
import { getCollection } from 'astro:content';
import { fechaPublicacion, estaPublicada } from '../utils/publicacion';
import '../styles/global.css';
import RelojActualidad from '../components/RelojActualidad.astro';
import Cosme from '../components/Cosme.astro';
import SaludoPortada from '../components/SaludoPortada.astro';
import Seo from '../components/Seo.astro';
import Cabecera from '../components/Cabecera.astro';
import TrabajaConmigoBanner from '../components/TrabajaConmigoBanner.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';

const contenidoEspera = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" class="actualidad-radar" aria-hidden="true" focusable="false" width="64" height="64">
  <g fill="none" stroke="#171943" stroke-linecap="round">
    <circle cx="31.5" cy="32.5" r="24" stroke-width="4"/>
    <circle cx="31.5" cy="32.5" r="16.5" stroke-width="4"/>
    <circle cx="31.5" cy="32.5" r="9" stroke-width="4"/>
  </g>
  <path class="actualidad-radar-aguja" d="M31.5 32.5 52 12" fill="none" stroke="#F05A2A" stroke-linecap="round" stroke-width="8"/>
</svg><span>En desarrollo</span><p>Este espacio se completará con la actualidad de hoy.</p>`;

const ahora = new Date();
const diaSemanaMadrid = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Madrid', weekday: 'short' }).format(ahora);
const esFinDeSemana = diaSemanaMadrid === 'Sat' || diaSemanaMadrid === 'Sun';
const publicados = (await getCollection('articulos')).filter((a) => a.data.fecha <= ahora).sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const todasLasNoticias = await getCollection('actualidad');
const actualidad = todasLasNoticias.filter(pieza => estaPublicada(pieza.data, ahora));
const destacados = publicados.filter((a) => a.data.serie !== 'trama').slice(0, 8);
const ultimasTramas = publicados.filter((a) => a.data.serie === 'trama').slice(0, 2);
const formatearFecha = (f: Date) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(f);
const formatearFechaCorta = (f: Date) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }).format(f).replace('.', '').toUpperCase();
// elijo una palabra del titular y conservo el texto original completo
const fragmentarTitular = (titulo: string, palabraDestacada?: string) => {
  const palabras = [...titulo.matchAll(/[\p{L}\p{N}]+(?:[-’'][\p{L}\p{N}]+)*/gu)];
  if (palabraDestacada !== undefined) {
    const seleccion = palabraDestacada.trim();
    if (!seleccion) return { antes: titulo, palabra: '', despues: '' };
    const literal = seleccion.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const elegida = new RegExp('(?<![\\p{L}\\p{N}_])' + literal + '(?![\\p{L}\\p{N}_])', 'iu').exec(titulo);
    if (!elegida) return { antes: titulo, palabra: '', despues: '' };
    const inicio = elegida.index!;
    return { antes: titulo.slice(0, inicio), palabra: elegida[0], despues: titulo.slice(inicio + elegida[0].length) };
  }
  const preferidas = ['Kodak', 'Neptuno', 'Marvel', 'Marianas', 'Voyager', 'Tesla', 'Matrix', 'átomo'];
  const elegida = preferidas.map(palabra => palabras.find(p => p[0].toLocaleLowerCase('es') === palabra.toLocaleLowerCase('es'))).find(Boolean)
    ?? palabras.filter(p => /\p{L}/u.test(p[0])).sort((a, b) => b[0].length - a[0].length)[0];
  if (!elegida) return { antes: titulo, palabra: '', despues: '' };
  const inicio = elegida.index!;
  return { antes: titulo.slice(0, inicio), palabra: elegida[0], despues: titulo.slice(inicio + elegida[0].length) };
};
const diasContinuo = [...new Set(todasLasNoticias.map(pieza => pieza.data.fecha.toISOString().slice(0, 10)))].sort().reverse();
const noticiasPorDia = diasContinuo.map(dia => ({
  dia,
  fecha: formatearFechaCorta(new Date(`${dia}T12:00:00Z`)),
  noticias: todasLasNoticias.filter(pieza => pieza.data.fecha.toISOString().slice(0, 10) === dia)
    .sort((a, b) => fechaPublicacion(b.data).getTime() - fechaPublicacion(a.data).getTime()),
}));
const fechaHoy = new Intl.DateTimeFormat('sv-SE', {
  timeZone: 'Europe/Madrid',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(ahora);
const actualidadHoy = actualidad.filter((pieza) => pieza.id.startsWith(`${fechaHoy}/`));
const seccionesActualidad = [
  { clave: 'tecnologia', nombre: 'Tecnología', numero: '01' },
  { clave: 'ciencia', nombre: 'Ciencia', numero: '02' },
  { clave: 'cine', nombre: 'Cine', numero: '03' },
  { clave: 'extra', nombre: 'Extra', numero: '04' },
].map((seccion) => ({ ...seccion, pieza: actualidadHoy.find((pieza) => pieza.data.categoria === seccion.clave) }));
---
<html lang="es">
<head><meta charset="utf-8"/><meta name="google-site-verification" content="3fyojwDNsYwGe-FEioqtgTpOwTy2bIOAhfgq3bU-s3E"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5"/><meta name="theme-color" content="#1B1836"/><Seo titulo="Nebula | Historias contadas con datos" descripcion="Nebula une periodismo y ciencia de datos para contar historias sobre cultura, deporte, ciencia y tecnología." imagen={destacados[0]?.data.imagenPortada}/></head>
<body>
<Cabecera/>
<main>
  <SaludoPortada />
  <section class="continuo-nebula" aria-label="Titulares de Actualidad por día" data-continuo>
    <div class="continuo-marca" aria-hidden="true"><strong>ACTUALIDAD</strong></div>
    <div class="continuo-ventana">
      <div class="continuo-pista" data-continuo-pista>
        {[false, true].map(copia => <div class="continuo-grupo" data-continuo-grupo={!copia || undefined} aria-hidden={copia ? 'true' : undefined}>
          {noticiasPorDia.map(({ dia, fecha, noticias }) => <div class="continuo-dia" data-continuo-dia hidden={!noticias.some(pieza => estaPublicada(pieza.data, ahora))}>
            <time class="continuo-fecha" datetime={dia}>{fecha}</time>
            {noticias.map(pieza => <a class="continuo-item" href={`/actualidad/${pieza.id}/`} tabindex={copia ? -1 : undefined} data-continuo-instante={fechaPublicacion(pieza.data).getTime()} hidden={!estaPublicada(pieza.data, ahora)}>
              <span class="continuo-titulo">{pieza.data.titulo}</span>
            </a>)}
          </div>)}
        </div>)}
      </div>
    </div>
    <button class="continuo-control" type="button" aria-label="Pausar titulares" aria-pressed="false" data-continuo-control><span aria-hidden="true">Ⅱ</span></button>
  </section>
  <section class="actualidad-portada contenedor" aria-labelledby="titulo-actualidad" data-actualidad-fecha={fechaHoy}>
    <header class="actualidad-cabecera cabecera-portada">
      <h1 id="titulo-actualidad">Actualidad</h1>
      <a href="/actualidad/">Ver todas las noticias <span aria-hidden="true">→</span></a>
    </header>
    <template data-actualidad-espera><div class="actualidad-espera" set:html={contenidoEspera} /></template>
    <div class="actualidad-descanso" data-actualidad-descanso hidden={!esFinDeSemana}>
      <svg class="actualidad-pausa" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true" focusable="false">
        <circle cx="32" cy="32" r="27" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M26 23v18m12-18v18" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="5" />
      </svg>
      <p class="actualidad-descanso-etiqueta">Volvemos el lunes</p>
      <h2>El fin de semana también se descansa</h2>
      <p>La actualidad vuelve el lunes. Mientras tanto, tienes historias por descubrir en Nebula.</p>
      <a href="/articulos/">Explorar los análisis <span aria-hidden="true">→</span></a>
    </div>
    <div class="actualidad-cuadricula" hidden={esFinDeSemana}>
      {seccionesActualidad.map(({ clave, nombre, numero, pieza }) => pieza ? (
        <article data-casilla={clave} data-noticia={pieza.id} class:list={['actualidad-casilla', `actualidad-${clave}`, 'tiene-pieza']}>
          <div class="actualidad-meta"><span>{numero} · {nombre}</span></div>
          <div class="actualidad-contenido">
            <h2>{(() => { const { antes, palabra, despues } = fragmentarTitular(pieza.data.titulo, pieza.data.palabraDestacada); return <>{antes}<span class="actualidad-palabra">{palabra}</span>{despues}</>; })()}</h2>
          </div>
          <a class="actualidad-leer" href={`/actualidad/${pieza.id}/`} aria-label={`Leer noticia: ${pieza.data.titulo}`}>Leer noticia <span aria-hidden="true">→</span></a>
        </article>
      ) : (
        <article data-casilla={clave} data-noticia="" class:list={['actualidad-casilla', `actualidad-${clave}`, 'esta-vacia']}>
          <div class="actualidad-meta"><span>{numero} · {nombre}</span></div>
          <div class="actualidad-espera" set:html={contenidoEspera} />
        </article>
      ))}
    </div>
    <Cosme />
    {todasLasNoticias.map(pieza => {
      const seccion = seccionesActualidad.find(s => s.clave === pieza.data.categoria);
      return seccion && <template data-noticia-plantilla data-dia={pieza.data.fecha.toISOString().slice(0, 10)} data-categoria={seccion.clave} data-instante={fechaPublicacion(pieza.data).getTime()} data-id={pieza.id}>
        <article data-casilla={seccion.clave} data-noticia={pieza.id} class:list={['actualidad-casilla', `actualidad-${seccion.clave}`, 'tiene-pieza']}>
          <div class="actualidad-meta"><span>{seccion.numero} · {seccion.nombre}</span></div>
          <div class="actualidad-contenido">
            <h2>{(() => { const { antes, palabra, despues } = fragmentarTitular(pieza.data.titulo); return <>{antes}<span class="actualidad-palabra">{palabra}</span>{despues}</>; })()}</h2>
          </div>
          <a class="actualidad-leer" href={`/actualidad/${pieza.id}/`} aria-label={`Leer noticia: ${pieza.data.titulo}`}>Leer noticia <span aria-hidden="true">→</span></a>
        </article>
      </template>;
    })}
  </section>
  <section class="ultimos contenedor" aria-labelledby="titulo-ultimos">
    <div class="cabecera-seccion cabecera-portada"><h1 id="titulo-ultimos">Historias con datos</h1><a href="/articulos/">Ver todas las historias <span aria-hidden="true">→</span></a></div>
    <div class="grid-articulos">{destacados.map((articulo) => <a class="tarjeta-articulo" href={`/articulos/${articulo.id}/`}><div class="tarjeta-imagen">{articulo.data.imagenPortada&&<img src={articulo.data.imagenPortada} alt=""/>}</div><article><div class="tarjeta-meta"><span>{articulo.data.tema}</span><time datetime={articulo.data.fecha.toISOString()}>{formatearFecha(articulo.data.fecha)}</time></div><h3>{articulo.data.titulo}</h3>{articulo.data.cifraDestacada&&<div class="tarjeta-dato"><strong>{articulo.data.cifraDestacada}</strong><span>{articulo.data.etiquetaCifra}</span></div>}</article></a>)}</div>
  </section>
  {ultimasTramas.length>0&&<section class="trama-portada contenedor" aria-labelledby="titulo-trama"><div class="cabecera-portada trama-cabecera"><h2 id="titulo-trama">Trama</h2><a href="/trama/">Ver todos los artículos <span aria-hidden="true">→</span></a></div><div class="trama-grid">{ultimasTramas.map((articulo)=><a class="tarjeta-articulo" href={`/articulos/${articulo.id}/`}><div class="tarjeta-imagen">{articulo.data.imagenPortada&&<img src={articulo.data.imagenPortada} alt="" loading="lazy"/>}</div><article><div class="tarjeta-meta"><span>TRAMA</span><time datetime={articulo.data.fecha.toISOString()}>{formatearFecha(articulo.data.fecha)}</time></div><h3>{articulo.data.titulo}</h3><p>{articulo.data.descripcion}</p></article></a>)}</div></section>}
  <TrabajaConmigoBanner/>
</main>
<footer class="pie-pagina contenedor"><p>© {new Date().getFullYear()} Nebula | Roberto Cantero</p><p>Periodismo y ciencia de datos | <a href="/privacidad/">Privacidad</a></p></footer><CloudflareAnalytics/><RelojActualidad/>
<script>
import { alCargarPagina } from '../scripts/ciclo-pagina';
alCargarPagina((escuchar, alSalir) => {
const raiz=document.querySelector('[data-mvp]');const remoto='https://robertocantero-mvp-nba.static.hf.space/data';const json=async u=>{const r=await fetch(u);if(!r.ok)throw new Error();return r.json()};const jornada=async()=>{try{const m=await json(`${remoto}/manifest.json`);const f=[...m].sort((a,b)=>b.localeCompare(a))[0];return await json(`${remoto}/contenido_${f}.json`)}catch{return json('/datos/mvp/ultima-jornada.json')}};const madrugada=fecha=>{const inicio=new Date(`${fecha}T12:00:00Z`),fin=new Date(inicio);fin.setUTCDate(fin.getUTCDate()+1);const dia=n=>new Intl.DateTimeFormat('es-ES',{day:'numeric',timeZone:'UTC'}).format(n);const mes=n=>new Intl.DateTimeFormat('es-ES',{month:'long',timeZone:'UTC'}).format(n).toUpperCase();return inicio.getUTCMonth()===fin.getUTCMonth()?`MADRUGADA DEL ${dia(inicio)} AL ${dia(fin)} DE ${mes(fin)}`:`MADRUGADA DEL ${dia(inicio)} DE ${mes(inicio)} AL ${dia(fin)} DE ${mes(fin)}`};jornada().then(datos=>{if(!raiz)return;raiz.querySelector('[data-mvp-jornada]').textContent=madrugada(datos.fecha);raiz.querySelector('[data-mvp-partidos]').textContent=datos.resultados?.length||0;raiz.querySelector('[data-mvp-recomendacion]').textContent=datos.recomendacion?.partido?.replace(' @ ',' — ')||'Una jornada para elegir sobre la marcha.';const texto=datos.recomendacion?.texto||'',foco=texto.match(/por (.*?):/)?.[1]?.replace(/\b(?:la|el|las|los)\s+/g,''),razon=texto.match(/: reúne (.*?)\./)?.[1];raiz.querySelector('[data-mvp-motivo]').textContent=foco&&razon?`Promete una noche de ${foco}, con ${razon}.`:foco?`Promete una noche de ${foco}.`:'Una historia que merece descubrirse.';const q=datos.quiz||datos.gate;raiz.querySelector('[data-mvp-pregunta]').textContent=q.pregunta;const opciones=raiz.querySelector('[data-mvp-opciones]');q.opciones.forEach((op,i)=>{const b=document.createElement('button');b.type='button';b.textContent=op;b.addEventListener('click',()=>{opciones.querySelectorAll('button').forEach((n,j)=>{n.disabled=true;n.classList.toggle('correcta',j===q.correcta_idx);n.classList.toggle('fallo',n===b&&j!==q.correcta_idx)});raiz.querySelector('[data-mvp-respuesta]').textContent=i===q.correcta_idx?`Correcto. ${q.explicacion}`:`La respuesta es ${q.opciones[q.correcta_idx]}. ${q.explicacion}`});opciones.appendChild(b)})}).catch(()=>{if(raiz)raiz.querySelector('[data-mvp-error]').hidden=false});
const continuo = document.querySelector<HTMLElement>('[data-continuo]');
const pista = continuo?.querySelector<HTMLElement>('[data-continuo-pista]');
const grupo = continuo?.querySelector<HTMLElement>('[data-continuo-grupo]');
const control = continuo?.querySelector<HTMLButtonElement>('[data-continuo-control]');
const ajustarContinuo = () => {
  if (!pista || !grupo) return;
  pista.style.setProperty('--continuo-recorrido', `${grupo.scrollWidth}px`);
  pista.style.setProperty('--continuo-duracion', `${Math.max(90, grupo.scrollWidth / 34)}s`);
};
const actualizarContinuo = () => {
  if (!continuo) return;
  const instante = Date.now();
  continuo.querySelectorAll<HTMLElement>('[data-continuo-instante]').forEach(enlace => {
    enlace.hidden = Number(enlace.dataset.continuoInstante) > instante;
  });
  continuo.querySelectorAll<HTMLElement>('[data-continuo-dia]').forEach(dia => {
    dia.hidden = ![...dia.querySelectorAll<HTMLElement>('[data-continuo-instante]')].some(enlace => !enlace.hidden);
  });
  ajustarContinuo();
};
actualizarContinuo();
document.fonts?.ready.then(ajustarContinuo);
escuchar(window, 'resize', ajustarContinuo);
escuchar(document, 'nebula:publicacion', actualizarContinuo);
control && escuchar(control, 'click', () => {
  const pausado = continuo!.toggleAttribute('data-pausado');
  control.setAttribute('aria-label', pausado ? 'Reanudar titulares' : 'Pausar titulares');
  control.setAttribute('aria-pressed', String(pausado));
  control.querySelector('span')!.textContent = pausado ? '▶' : 'Ⅱ';
});

});
</script>
</body></html>
<style>
.actualidad-portada{padding-bottom:clamp(2rem,4vw,2.5rem);padding-top:clamp(3.5rem,7vw,5.5rem)}
.actualidad-cabecera{align-items:end;border-bottom:1px solid var(--color-border);display:flex;gap:2rem;justify-content:space-between;padding-bottom:1.25rem}
.actualidad-cabecera h1{color:#d85a30;font:600 clamp(1.35rem,2.5vw,2.1rem)/1 var(--font-heading);letter-spacing:-.02em;margin:0}
.actualidad-cabecera>time{color:#446ddf;font:600 11px var(--font-mono);letter-spacing:0;text-align:right;text-transform:uppercase}
.actualidad-cuadricula{border-inline:1px solid var(--color-border);border-bottom:1px solid var(--color-border);display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}

.actualidad-casilla{border-right:1px solid var(--color-border);color:#1b1836;display:flex;flex-direction:column;min-height:250px;padding:1.25rem;position:relative;text-decoration:none}
.actualidad-casilla:last-child{border-right:0}
.actualidad-meta{align-items:center;display:flex;font:600 10px var(--font-mono);justify-content:center;letter-spacing:.08em;position:relative;text-align:center;text-transform:uppercase;width:100%}
.actualidad-meta>span{display:block;text-align:center;width:100%}
.actualidad-meta>time{position:absolute;right:0;top:calc(100% + .35rem)}
.actualidad-contenido{align-items:center;display:flex;flex:1;justify-content:center;padding:1.5rem 0;width:100%}
.actualidad-contenido>strong{align-self:end;color:#446ddf;font:600 clamp(1.45rem,2.6vw,2.2rem)/1 var(--font-heading);grid-row:2;letter-spacing:-.04em;white-space:nowrap}
.actualidad-casilla h2{font-size:clamp(1rem,1.45vw,1.2rem);line-height:1.18;margin:0;max-width:23ch}
.actualidad-casilla>p{color:var(--color-secondary-text);line-height:1.5;margin:0;max-width:52ch}
.actualidad-casilla>b{font:600 10px var(--font-mono);margin-top:1.5rem;text-transform:uppercase}
.actualidad-espera{margin:auto 0 0}
.actualidad-espera>span{color:#446ddf;font:600 clamp(1.35rem,2vw,1.8rem)/1 var(--font-heading);letter-spacing:-.03em}
.actualidad-espera p{color:var(--color-secondary-text);font-size:13px;margin:1rem 0 0;max-width:28ch}
.actualidad-casilla.esta-vacia{background-image:radial-gradient(circle at 1px 1px,rgb(68 109 223/13%) 1px,transparent 0);background-size:18px 18px}
.actualidad-casilla.tiene-pieza{background:#fff;transition:background-color .2s ease,color .2s ease}
.actualidad-casilla.tiene-pieza h2{color:#1b1836;font-size:clamp(1.15rem,1.65vw,1.4rem);line-height:1.3;max-width:22ch;text-align:center;text-wrap:balance;overflow-wrap:anywhere}
.actualidad-palabra{color:#446ddf}
.actualidad-leer{align-self:center;color:#446ddf;font:600 11px/1.5 var(--font-mono);padding:.5rem 0;text-align:center;text-decoration:none}
.actualidad-leer:hover,.actualidad-leer:focus-visible{text-decoration:underline;text-underline-offset:4px}
@media (min-width: 701px) and (max-width: 900px) {
  .actualidad-cuadricula { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .actualidad-casilla:nth-child(even) { border-right: 0; }
  .actualidad-casilla:nth-child(n+3) { border-top: 1px solid var(--color-border); }
}
@media (max-width: 700px) {
  .actualidad-cuadricula { grid-template-columns: minmax(0, 1fr); }
  .actualidad-casilla { border-right: 0; }
  .actualidad-casilla + .actualidad-casilla { border-top: 1px solid var(--color-border); }
}
@media(max-width:700px){
  .actualidad-cabecera{align-items:start;flex-direction:column;gap:1rem}
  .actualidad-cabecera>time{text-align:left}
  .actualidad-casilla{min-height:230px}
}
@media(prefers-reduced-motion:reduce){.actualidad-casilla.tiene-pieza{transition:none}}
.ultimos{padding-bottom:clamp(2rem,4vw,2.5rem);padding-top:0}.ultimos .cabecera-seccion{border-top:0;padding-top:0}.ultimos .cabecera-seccion>a{font:600 11px var(--font-mono);text-decoration:none}.trama-portada p{color:var(--color-accent);font:10px var(--font-mono);letter-spacing:.07em;margin:0}
