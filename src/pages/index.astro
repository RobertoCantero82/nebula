---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Cabecera from '../components/Cabecera.astro';
import TrabajaConmigoBanner from '../components/TrabajaConmigoBanner.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';

const ahora = new Date();
const publicados = (await getCollection('articulos')).filter((a) => a.data.fecha <= ahora).sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const destacados = publicados.filter((a) => a.data.serie !== 'trama').slice(0, 8);
const ultimaTrama = publicados.find((a) => a.data.serie === 'trama');
const formatearFecha = (f: Date) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(f);
---
<html lang="es">
<head><meta charset="utf-8"/><meta name="google-site-verification" content="3fyojwDNsYwGe-FEioqtgTpOwTy2bIOAhfgq3bU-s3E"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="icon" type="image/svg+xml" href="/nebula/favicon.svg?v=4"/><meta name="theme-color" content="#1B1836"/><Seo titulo="Nebula | Historias contadas con datos" descripcion="Nebula une periodismo y ciencia de datos para contar historias sobre cultura, deporte, ciencia y tecnología." imagen={destacados[0]?.data.imagenPortada}/></head>
<body>
<Cabecera/>
<main>
  <TrabajaConmigoBanner/>
  <section class="ultimos contenedor" aria-labelledby="titulo-ultimos">
    <div class="cabecera-seccion"><div><p class="indice-seccion">ÚLTIMOS ANÁLISIS</p><h1 id="titulo-ultimos" class="sr-only">Últimos análisis</h1></div><a href="/nebula/articulos/">Ver todos los análisis <span aria-hidden="true">→</span></a></div>
    <div class="grid-articulos">{destacados.map((articulo) => <a class="tarjeta-articulo" href={`/nebula/articulos/${articulo.id}/`}><div class="tarjeta-imagen">{articulo.data.imagenPortada&&<img src={articulo.data.imagenPortada} alt=""/>}</div><article><div class="tarjeta-meta"><span>{articulo.data.tema}</span><time datetime={articulo.data.fecha.toISOString()}>{formatearFecha(articulo.data.fecha)}</time></div><h3>{articulo.data.titulo}</h3>{articulo.data.cifraDestacada&&<div class="tarjeta-dato"><strong>{articulo.data.cifraDestacada}</strong><span>{articulo.data.etiquetaCifra}</span></div>}</article></a>)}</div>
  </section>
  {ultimaTrama&&<section class="trama-portada contenedor" aria-labelledby="titulo-trama"><div class="trama-presentacion"><h2 id="titulo-trama">Trama</h2><span>En Trama utilizo datos, créditos y detalles de la pantalla para buscar el punto exacto en el que dos películas aparentemente alejadas terminan tocándose.</span><a href="/nebula/trama/">Ver todas las entregas <span aria-hidden="true">→</span></a></div><a class="trama-ultima" href={`/nebula/articulos/${ultimaTrama.id}/`}><div>{ultimaTrama.data.imagenPortada&&<img src={ultimaTrama.data.imagenPortada} alt="" loading="lazy"/>}</div><article><p>ÚLTIMA ENTREGA</p><h3>{ultimaTrama.data.titulo}</h3><span>{ultimaTrama.data.descripcion}</span><b>Descubrir la conexión <span aria-hidden="true">→</span></b></article></a></section>}
  <section class="mvp-portada contenedor" aria-labelledby="titulo-mvp" data-mvp>
    <div class="mvp-modulo">
      <header class="mvp-barra">
        <h2 id="titulo-mvp" class="mvp-marca"><strong>AGENTE MVP</strong><small>(la jornada NBA, sin resultados ni gaitas)</small></h2>
      </header>
      <div class="mvp-cancha">
        <div class="mvp-banderines">
          <article class="mvp-banderin mvp-banderin-jornada"><span>JORNADA</span><strong data-mvp-jornada>ÚLTIMA MADRUGADA</strong><div class="mvp-total"><b data-mvp-partidos>0</b><small>PARTIDOS</small></div></article>
          <article class="mvp-banderin mvp-banderin-curiosidad"><span>PARTIDO RECOMENDADO</span><p data-mvp-recomendacion>Buscando el partido de la jornada.</p><small data-mvp-motivo>Una historia que merece descubrirse.</small></article>
        </div>
        <aside class="mvp-reto"><p>EL RETO DE LA JORNADA</p><h3 data-mvp-pregunta>Cargando la pregunta de la noche</h3><div data-mvp-opciones class="mvp-opciones"></div><div data-mvp-respuesta class="mvp-respuesta" aria-live="polite"></div><a href="https://robertocantero-mvp-nba.static.hf.space/index.html" target="_blank" rel="noopener noreferrer">Abrir la jornada en M.V.P. <span aria-hidden="true">↗</span></a></aside>
      </div>
      <p class="mvp-error" data-mvp-error hidden>No he podido actualizar la jornada. Puedes consultarla directamente en M.V.P.</p>
    </div>
  </section>
  <section class="manifiesto-nebula" aria-labelledby="titulo-manifiesto"><div class="contenedor"><h2 id="titulo-manifiesto">Periodismo para entender los datos, no solo mirarlos</h2><a href="/nebula/sobre-nebula/">Sobre Nebula <span aria-hidden="true">→</span></a></div></section>
</main>
<footer class="pie-pagina contenedor"><p>© {new Date().getFullYear()} Nebula | Roberto Cantero</p><p>Periodismo y ciencia de datos | <a href="/nebula/privacidad/">Privacidad</a></p></footer><CloudflareAnalytics/>
<script>
const raiz=document.querySelector('[data-mvp]');const remoto='https://robertocantero-mvp-nba.static.hf.space/data';const json=async u=>{const r=await fetch(u);if(!r.ok)throw new Error();return r.json()};const jornada=async()=>{try{const m=await json(`${remoto}/manifest.json`);const f=[...m].sort((a,b)=>b.localeCompare(a))[0];return await json(`${remoto}/contenido_${f}.json`)}catch{return json('/nebula/datos/mvp/ultima-jornada.json')}};const madrugada=fecha=>{const inicio=new Date(`${fecha}T12:00:00Z`),fin=new Date(inicio);fin.setUTCDate(fin.getUTCDate()+1);const dia=n=>new Intl.DateTimeFormat('es-ES',{day:'numeric',timeZone:'UTC'}).format(n);const mes=n=>new Intl.DateTimeFormat('es-ES',{month:'long',timeZone:'UTC'}).format(n).toUpperCase();return inicio.getUTCMonth()===fin.getUTCMonth()?`MADRUGADA DEL ${dia(inicio)} AL ${dia(fin)} DE ${mes(fin)}`:`MADRUGADA DEL ${dia(inicio)} DE ${mes(inicio)} AL ${dia(fin)} DE ${mes(fin)}`};jornada().then(datos=>{if(!raiz)return;raiz.querySelector('[data-mvp-jornada]').textContent=madrugada(datos.fecha);raiz.querySelector('[data-mvp-partidos]').textContent=datos.resultados?.length||0;raiz.querySelector('[data-mvp-recomendacion]').textContent=datos.recomendacion?.partido?.replace(' @ ',' — ')||'Una jornada para elegir sobre la marcha.';const texto=datos.recomendacion?.texto||'',foco=texto.match(/por (.*?):/)?.[1]?.replace(/\b(?:la|el|las|los)\s+/g,''),razon=texto.match(/: reúne (.*?)\./)?.[1];raiz.querySelector('[data-mvp-motivo]').textContent=foco&&razon?`Promete una noche de ${foco}, con ${razon}.`:foco?`Promete una noche de ${foco}.`:'Una historia que merece descubrirse.';const q=datos.quiz||datos.gate;raiz.querySelector('[data-mvp-pregunta]').textContent=q.pregunta;const opciones=raiz.querySelector('[data-mvp-opciones]');q.opciones.forEach((op,i)=>{const b=document.createElement('button');b.type='button';b.textContent=op;b.addEventListener('click',()=>{opciones.querySelectorAll('button').forEach((n,j)=>{n.disabled=true;n.classList.toggle('correcta',j===q.correcta_idx);n.classList.toggle('fallo',n===b&&j!==q.correcta_idx)});raiz.querySelector('[data-mvp-respuesta]').textContent=i===q.correcta_idx?`Correcto. ${q.explicacion}`:`La respuesta es ${q.opciones[q.correcta_idx]}. ${q.explicacion}`});opciones.appendChild(b)})}).catch(()=>{if(raiz)raiz.querySelector('[data-mvp-error]').hidden=false});
</script>
</body></html>
<style>
.ultimos{padding-bottom:clamp(4rem,8vw,6.5rem);padding-top:clamp(2rem,4vw,3rem)}.ultimos .cabecera-seccion>a{font:600 11px var(--font-mono);text-decoration:none}.trama-portada p{color:var(--color-accent);font:10px var(--font-mono);letter-spacing:.07em;margin:0}
.mvp-portada{margin-bottom:clamp(3rem,7vw,5rem)}.mvp-modulo{background:#10251f;border:1px solid #284139;color:#f3ead3;overflow:hidden}.mvp-barra{align-items:center;display:flex;justify-content:space-between;min-height:52px;padding:.65rem 1.25rem}.mvp-marca{align-items:center;display:flex;gap:.55rem}.mvp-marca>span{border:2px solid #e7a33f;border-radius:50%;height:14px;position:relative;width:14px}.mvp-marca>span:after{border:1px solid #e7a33f;border-radius:50%;content:"";inset:2px;position:absolute}.mvp-marca strong{color:#f3ead3;font:900 1.35rem/1 "Arial Narrow",Impact,sans-serif;letter-spacing:.08em}.mvp-marca small{color:#d3c9af;font:8px var(--font-mono);letter-spacing:.13em;margin-left:.35rem}.mvp-barra p{color:#e7a33f;font:10px var(--font-mono);letter-spacing:.08em;margin:0}.mvp-cancha{align-items:center;background-color:#453e2f;background-image:linear-gradient(90deg,rgb(255 255 255/4%) 1px,transparent 1px),linear-gradient(rgb(255 255 255/4%) 1px,transparent 1px),repeating-linear-gradient(90deg,transparent 0 92px,rgb(17 37 31/12%) 92px 96px);background-size:96px 48px,96px 48px,192px 96px;border-top:1px solid #63573f;display:grid;gap:clamp(1.25rem,3vw,2.5rem);grid-template-columns:150px minmax(190px,.75fr) minmax(360px,1.35fr);padding:1.5rem clamp(1.25rem,3vw,2rem)}.mvp-banderin{align-items:center;background:#efe5c9;box-shadow:0 5px 0 #d9a245;color:#173a30;display:flex;flex-direction:column;justify-content:center;min-height:172px;padding:1rem;position:relative;text-align:center}.mvp-banderin:after{border-left:75px solid transparent;border-right:75px solid transparent;border-top:28px solid #efe5c9;bottom:-28px;content:"";left:0;position:absolute}.mvp-banderin span,.mvp-banderin small{font:700 10px var(--font-mono);letter-spacing:.12em}.mvp-banderin strong{font:900 4rem/.95 "Arial Narrow",Impact,sans-serif;margin:.35rem 0}.mvp-presentacion>p,.mvp-reto>p{color:#efb34f;font:9px var(--font-mono);letter-spacing:.12em;margin:0}.mvp-presentacion h2{color:#fff8e7;font:900 clamp(1.85rem,3.2vw,3rem)/.95 "Arial Narrow",Impact,sans-serif;letter-spacing:-.02em;margin:.65rem 0 .8rem;text-transform:uppercase}.mvp-presentacion>span{color:#e0d5bd;font-size:13px;line-height:1.45}.mvp-reto{background:rgb(16 37 31/92%);border:1px solid #6b6049;padding:1.2rem}.mvp-reto h3{color:#fff8e7;font-size:clamp(1.15rem,1.8vw,1.45rem);line-height:1.15;margin:.5rem 0 .9rem}.mvp-opciones{display:grid;gap:.5rem;grid-template-columns:repeat(2,minmax(0,1fr))}.mvp-opciones button{background:#17362d!important;border:1px solid #807257;color:#f3ead3!important;cursor:pointer;font:10px var(--font-mono);min-height:38px;padding:.55rem .7rem;text-align:left}.mvp-opciones button:hover{border-color:#e7a33f}.mvp-opciones button.correcta{background:#e7a33f!important;border-color:#e7a33f;color:#10251f!important}.mvp-opciones button.fallo{border-color:#d85a30;color:#f1a189!important}.mvp-respuesta{color:#d8cfb8;font-size:12px;line-height:1.4;margin-top:.7rem}.mvp-reto>a{color:#efb34f;display:inline-block;font:600 10px var(--font-mono);margin-top:.9rem;text-underline-offset:4px}.mvp-error{background:#fff3d7;color:#553d17;font-size:12px;margin:0;padding:.75rem 1.25rem}
.trama-portada{display:grid;gap:clamp(2rem,6vw,5rem);grid-template-columns:.65fr 1.35fr;padding-bottom:clamp(4rem,9vw,7rem);padding-top:clamp(4rem,9vw,7rem)}.trama-presentacion{align-self:center}.trama-presentacion h2{font-size:clamp(2.2rem,4vw,3.7rem);line-height:1.02;margin:.8rem 0 1.25rem}.trama-presentacion>span{color:var(--color-secondary-text);display:block;line-height:1.65}.trama-presentacion>a{display:inline-block;font:600 11px var(--font-mono);margin-top:1.5rem}.trama-ultima{display:grid;grid-template-columns:1.1fr .9fr;text-decoration:none}.trama-ultima>div{background:#eeeae1;min-height:360px}.trama-ultima img{height:100%;object-fit:cover;width:100%}.trama-ultima article{background:#fff;border:1px solid var(--color-border);display:flex;flex-direction:column;justify-content:center;padding:2rem}.trama-ultima h3{font-size:clamp(1.6rem,2.7vw,2.3rem);line-height:1.1;margin:.8rem 0 1rem}@media(max-width:900px){.mvp-cancha{grid-template-columns:120px 1fr}.mvp-banderin{min-height:150px}.mvp-banderin:after{border-left-width:60px;border-right-width:60px}.mvp-reto{grid-column:1/-1}}@media(max-width:760px){.trama-portada{grid-template-columns:1fr}.trama-ultima{grid-template-columns:1fr}.trama-ultima>div{min-height:260px}}@media(max-width:560px){.mvp-marca small{display:none}.mvp-cancha{grid-template-columns:1fr;padding-bottom:1.25rem}.mvp-banderin{justify-self:center;width:120px}.mvp-banderin:after{border-left-width:60px;border-right-width:60px}.mvp-presentacion{text-align:center}.mvp-reto{grid-column:auto}.mvp-opciones{grid-template-columns:1fr}}
</style>
<style>
  .trama-portada { border-top: 1px solid var(--color-border); }
  .mvp-portada { margin-bottom: clamp(3rem, 7vw, 5rem); }
  .mvp-barra { justify-content: flex-start; min-height: 58px; }
  .mvp-marca { gap: .75rem; margin: 0; }
  .mvp-marca strong { font-size: clamp(1rem, 1.8vw, 1.35rem); letter-spacing: .09em; }
  .mvp-marca small { color: #d3c9af; font: 9px var(--font-mono); letter-spacing: .04em; margin: 0; }
  .mvp-circulos { align-items: center; display: flex; height: 22px; width: 50px; }
  .mvp-circulos i { border: 2px solid #e7a33f; border-radius: 50%; display: block; height: 18px; margin-left: -4px; width: 18px; }
  .mvp-circulos i:first-child { margin-left: 0; }
  .mvp-cancha {
    align-items: stretch;
    background-color: #494230;
    background-image:
      linear-gradient(45deg, rgb(23 38 31 / 12%) 25%, transparent 25%, transparent 75%, rgb(23 38 31 / 12%) 75%),
      linear-gradient(-45deg, rgb(255 255 255 / 3%) 25%, transparent 25%, transparent 75%, rgb(255 255 255 / 3%) 75%);
    background-position: 0 0, 42px 42px;
    background-size: 84px 84px;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    grid-template-columns: minmax(360px, .95fr) minmax(380px, 1.05fr);
    padding: clamp(2rem, 4vw, 3.25rem);
  }
  .mvp-banderines { display: grid; gap: clamp(1rem, 2vw, 1.5rem); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mvp-banderin {
    box-shadow: none;
    clip-path: polygon(0 0, 100% 0, 100% 86%, 50% 100%, 0 86%);
    justify-content: flex-start;
    min-height: 220px;
    padding: 1.5rem 1.15rem 2.6rem;
  }
  .mvp-banderin:after { display: none; }
  .mvp-banderin:before { border: 1px solid rgb(23 58 48 / 35%); clip-path: polygon(0 0, 100% 0, 100% 86%, 50% 100%, 0 86%); content: ""; inset: 8px; position: absolute; }
  .mvp-banderin > * { position: relative; z-index: 1; }
  .mvp-banderin-jornada { background: #efe5c9; color: #173a30; }
  .mvp-banderin-curiosidad { background: #d8cba8; color: #173a30; }
  .mvp-banderin span { border-bottom: 1px solid rgb(23 58 48 / 35%); padding-bottom: .65rem; width: 100%; }
  .mvp-banderin strong { font: 800 clamp(1.05rem, 1.7vw, 1.35rem)/1.15 "Arial Narrow", Impact, sans-serif; margin: 1.25rem 0 .8rem; text-transform: uppercase; }
  .mvp-banderin small { font-size: 8px; line-height: 1.35; }
  .mvp-total { align-items: center; display: flex; flex-direction: column; margin-bottom: .75rem; margin-top: auto; }
  .mvp-total b { font: 400 clamp(4.5rem, 7vw, 6rem)/.78 "Arial Narrow", Impact, sans-serif; }
  .mvp-total small { font-weight: 400; letter-spacing: .12em; margin-top: .35rem; }
  .mvp-banderin p { font: 700 clamp(.9rem, 1.3vw, 1.05rem)/1.32 var(--font-heading); margin: 1.15rem 0 0; }
  .mvp-banderin-curiosidad > small { font-family: var(--font-heading); font-size: .72rem; font-weight: 400; letter-spacing: 0; line-height: 1.35; margin-top: .75rem; }
  .mvp-reto { align-self: center; padding: clamp(1.25rem, 2.5vw, 1.75rem); }
  .mvp-reto h3 { font-size: clamp(1.2rem, 2vw, 1.65rem); }
  :global(.mvp-opciones button) { background: #17362d; border: 1px solid #807257; color: #f3ead3; cursor: pointer; font: 10px var(--font-mono); min-height: 38px; padding: .55rem .7rem; text-align: left; }
  :global(.mvp-opciones button:hover) { border-color: #e7a33f; }
  :global(.mvp-opciones button.correcta) { background: #e7a33f; border-color: #e7a33f; color: #10251f; }
  :global(.mvp-opciones button.fallo) { border-color: #d85a30; color: #f1a189; }
  @media (max-width: 900px) {
    .mvp-cancha { grid-template-columns: 1fr; }
    .mvp-reto { grid-column: auto; }
  }
  @media (max-width: 560px) {
    .mvp-cancha { padding: 1.25rem; }
    .mvp-marca { align-items: flex-start; flex-direction: column; gap: .3rem; }
    .mvp-marca small { display: block; }
    .mvp-banderines { grid-template-columns: 1fr; }
    .mvp-banderin { justify-self: stretch; width: auto; }
  }
  .manifiesto-nebula { background: var(--color-accent); color: #fff; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .manifiesto-nebula > .contenedor { align-items: center; display: flex; gap: 2rem; justify-content: space-between; min-height: clamp(76px, 8vw, 104px); }
  .manifiesto-nebula h2 { font-size: clamp(1.25rem, 2.6vw, 2rem); line-height: 1.1; margin: 0; }
  .manifiesto-nebula a { flex: 0 0 auto; font: 600 11px var(--font-mono); text-underline-offset: 5px; }
  @media (max-width: 620px) { .manifiesto-nebula > .contenedor { align-items: flex-start; flex-direction: column; gap: .55rem; justify-content: center; min-height: 96px; padding-bottom: 1rem; padding-top: 1rem; } }
</style>
