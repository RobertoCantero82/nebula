---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import AutorPerfil from '../components/AutorPerfil.astro';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';

const { titulo, descripcion, tema, fecha, cifraDestacada, etiquetaCifra, metodologia, imagenPortada, relacionados = [] } = Astro.props;

const origen = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origen);
const imagenSocial = imagenPortada ? new URL(imagenPortada, origen) : undefined;
const perfilAutor = new URL('/nebula/trabaja-conmigo/', origen);
const identificadorAutor = new URL('#roberto-cantero', perfilAutor).href;
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: titulo,
  description: descripcion,
  datePublished: fecha.toISOString(),
  dateModified: fecha.toISOString(),
  inLanguage: 'es-ES',
  mainEntityOfPage: canonical.href,
  ...(imagenSocial ? { image: [imagenSocial.href] } : {}),
  author: {
    '@id': identificadorAutor,
    '@type': 'Person',
    name: 'Roberto Cantero',
    url: perfilAutor.href,
    image: new URL('/nebula/imagenes/roberto-cantero.jpg', origen).href,
    jobTitle: 'Periodista especializado en tecnología, ciencia y datos',
    sameAs: [
      'https://www.linkedin.com/in/robertocanterog/',
      'https://robertocantero.carrd.co',
    ],
  },
  publisher: {
    '@type': 'Organization',
    name: 'Nebula',
    url: new URL('/nebula/', origen).href,
  },
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/nebula/favicon.svg?v=2" />
    <meta name="theme-color" content="#1B1836" />
    <Seo
      titulo={`${titulo} | Nebula`}
      descripcion={descripcion}
      imagen={imagenPortada}
      tipo="article"
      fecha={fecha}
    />
    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  </head>
  <body>
    <header class="contenedor" style="display: flex; align-items: center; justify-content: space-between; padding-top: 1.5rem; padding-bottom: 1.5rem;">
      <a href="/nebula/" style="text-decoration: none;">
        <svg width="110" height="32" viewBox="0 0 110 32">
          <circle cx="7" cy="8" r="3" fill="#D85A30" />
          <text x="0" y="27" font-family="Zilla Slab" font-weight="600" font-size="24" fill="#1B1836">Nebula</text>
        </svg>
      </a>
    </header>

    <div class="portada-articulo">
      {imagenPortada ? (
        <img src={imagenPortada} alt={titulo} style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      ) : (
        <svg viewBox="0 0 1200 260" preserveAspectRatio="xMidYMid slice" width="100%" height="100%" aria-hidden="true">
          <rect width="1200" height="260" fill="#1B1836" />
          {Array.from({ length: 40 }).map((_, i) => (
            <line x1={i * 32} y1="0" x2={i * 32} y2="260" stroke={i % 3 === 0 ? '#D85A30' : '#8B85C4'} stroke-width="1" opacity={0.15 + (i % 5) * 0.05} />
          ))}
          <circle cx="120" cy="70" r="3" fill="#D85A30" />
          <circle cx="950" cy="180" r="4" fill="#8B85C4" />
          <circle cx="600" cy="40" r="2" fill="#D85A30" />
        </svg>
      )}
    </div>

    <main class="contenedor" style="padding-top: 2rem; padding-bottom: 3rem;">
      <div class="contenido-articulo">
        <p style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent-2); letter-spacing: 0.5px; margin: 0 0 8px;">{tema}</p>
        <h1 style="font-size: clamp(28px, 4vw, 34px); line-height: 1.25; margin: 0 0 16px;">{titulo}</h1>

        {cifraDestacada && (
          <div style="text-align: center; margin-bottom: 24px;">
            <div style="background: white; border: 1px solid var(--color-border); border-radius: 8px; padding: 14px 18px; display: inline-block;">
              <p style="font-family: var(--font-mono); font-size: 20px; margin: 0; color: var(--color-ink);">{cifraDestacada}</p>
              <p style="font-size: 11px; color: var(--color-secondary-text); margin: 2px 0 0;">{etiquetaCifra}</p>
            </div>
          </div>
        )}

        <article class="cuerpo-articulo" style="font-size: 16px; line-height: 1.7;">
          <slot />
        </article>

        {metodologia && (
          <details style="margin-top: 32px; border-top: 1px solid var(--color-border); padding-top: 16px;">
            <summary style="font-family: var(--font-mono); font-size: 12px; color: var(--color-secondary-text); cursor: pointer;">Metodología</summary>
            <div style="font-size: 14px; color: var(--color-secondary-text); margin-top: 10px; line-height: 1.6;">
              {metodologia}
            </div>
          </details>
        )}

        <aside class="compartir-articulo" aria-labelledby="titulo-compartir">
          <div>
            <p class="compartir-etiqueta">AYUDA A QUE ESTA HISTORIA VIAJE</p>
            <h2 id="titulo-compartir">¿Te ha parecido interesante?</h2>
          </div>
          <div class="compartir-acciones">
            <button type="button" data-share>Compartir</button>
            <button type="button" data-copy-link>Copiar enlace</button>
          </div>
          <p class="compartir-estado" data-share-status aria-live="polite"></p>
        </aside>

        <AutorPerfil />
      </div>

      <ArticulosRelacionados articulos={relacionados} />
    </main>

    <script>
      const copiarEnlace = async () => {
        const estado = document.querySelector('[data-share-status]');
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (estado) estado.textContent = 'Enlace copiado.';
        } catch {
          const campo = document.createElement('textarea');
          campo.value = window.location.href;
          campo.style.position = 'fixed';
          campo.style.opacity = '0';
          document.body.appendChild(campo);
          campo.select();
          document.execCommand('copy');
          campo.remove();
          if (estado) estado.textContent = 'Enlace copiado.';
        }
      };

      document.querySelector('[data-copy-link]')?.addEventListener('click', copiarEnlace);
      document.querySelector('[data-share]')?.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title, url: window.location.href });
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
            await copiarEnlace();
          }
          return;
        }
        await copiarEnlace();
      });
    </script>
  </body>
</html>
