---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Seo from '../components/Seo.astro';
import RelojActualidad from '../components/RelojActualidad.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import { fechaPublicacion } from '../utils/publicacion';

const { pieza } = Astro.props;
const { titulo, descripcion, fecha, pasos, antesDeEmpezar, resultado, consejo, fuentes } = pieza.data;
const instante = fechaPublicacion(pieza.data).getTime();
const fechaLarga = new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', day: 'numeric', month: 'long', year: 'numeric' }).format(fecha);
const seleccion = pieza.data.palabraDestacada?.trim();
const posicion = seleccion ? titulo.toLocaleLowerCase('es').indexOf(seleccion.toLocaleLowerCase('es')) : -1;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <Seo titulo={`${titulo} | Hazlo fácil | Nebula`} descripcion={descripcion} tipo="article" fecha={fecha} />
    <script is:inline define:vars={{ instante }}>
      if (Date.now() < instante) document.documentElement.dataset.noticiaPendiente = 'true';
    </script>
    <style is:global>
      html[data-noticia-pendiente] body > :not([data-aviso-programada]):not(script) { display:none !important; }
      [data-aviso-programada] { display:none; }
      html[data-noticia-pendiente] [data-aviso-programada] { display:block; max-width:760px; margin:auto; padding:4rem 1.5rem; }
    </style>
  </head>
  <body>
    <aside data-aviso-programada data-desbloquear={instante}><p>Esta guía todavía no está disponible. Aparecerá al llegar su momento de publicación.</p><a href="/">Volver a Nebula</a></aside>
    <Cabecera activa="hazlo-facil" />
    <main class="guia contenedor">
      <article>
        <header class="guia-cabecera">
          <a class="guia-seccion" href="/temas/hazlo-facil/">Hazlo fácil</a>
          <p class="guia-promesa">Pequeñas soluciones para tu día a día</p>
          <h1>{posicion >= 0 ? <>{titulo.slice(0, posicion)}<span>{titulo.slice(posicion, posicion + seleccion!.length)}</span>{titulo.slice(posicion + seleccion!.length)}</> : titulo}</h1>
          <p class="guia-descripcion">{descripcion}</p>
          <p class="guia-firma">Roberto Cantero · <time datetime={fecha.toISOString()}>{fechaLarga}</time></p>
        </header>
        {antesDeEmpezar.length > 0 && <section class="guia-antes" aria-labelledby="antes"><h2 id="antes">Antes de empezar</h2><ul>{antesDeEmpezar.map(texto => <li>{texto}</li>)}</ul></section>}
        <ol class="guia-pasos" aria-label="Pasos del tutorial">
          {pasos.map((paso, indice) => <li id={`paso-${indice + 1}`}>
            <span class="guia-numero" aria-hidden="true">{String(indice + 1).padStart(2, '0')}</span>
            <div><h2>{paso.titulo}</h2>{paso.texto.map(texto => <p>{texto}</p>)}
              {paso.imagen && <figure><img src={paso.imagen} alt={paso.altImagen} loading="lazy" />{paso.pieImagen && <figcaption>{paso.pieImagen}</figcaption>}</figure>}
            </div>
          </li>)}
        </ol>
        <section class="guia-resultado" aria-labelledby="resultado"><h2 id="resultado">Ya lo tienes</h2><p>{resultado}</p></section>
        {consejo && <aside class="guia-consejo"><h2>Un detalle útil</h2><p>{consejo}</p></aside>}
        <div class="guia-ampliacion"><slot /></div>
        <section class="guia-fuentes" aria-labelledby="fuentes"><h2 id="fuentes">Fuentes y ayuda</h2><ul>{fuentes.map(fuente => <li><a href={fuente.url} target="_blank" rel="noopener noreferrer">{fuente.nombre}<span class="solo-lectores"> (se abre en una nueva pestaña)</span></a>{fuente.detalle && <p>{fuente.detalle}</p>}</li>)}</ul></section>
        <a class="guia-mas" href="/temas/hazlo-facil/">Más Hazlo fácil</a>
      </article>
    </main>
    <footer class="pie-pagina contenedor"><p>© {new Date().getFullYear()} Nebula | Roberto Cantero</p><a href="/privacidad/">Privacidad</a></footer>
    <CloudflareAnalytics /><RelojActualidad />
  </body>
</html>
<style>
  .guia { max-width:860px; padding-top:clamp(2rem,5vw,4rem); padding-bottom:4rem; }
  .guia-cabecera { border-bottom:1px solid var(--color-border); padding-bottom:2rem; }
  .guia-seccion { color:#3558bd; font:600 .85rem/1.5 var(--font-mono); text-underline-offset:4px; }
  .guia-promesa,.guia-firma { color:var(--color-secondary-text); font-size:.85rem; line-height:1.6; }
  h1 { color:var(--color-ink); font-size:clamp(2.2rem,6vw,3.6rem); line-height:1.08; margin:1.5rem 0 1rem; overflow-wrap:anywhere; }
  h1 span,.guia-numero { color:#446ddf; }
  .guia-descripcion { font-size:1.15rem; line-height:1.65; }
  h2 { font-size:clamp(1.4rem,3vw,1.8rem); line-height:1.2; margin:0 0 .8rem; }
  p,li { line-height:1.75; }
  .guia-antes { padding:1.75rem 0; border-bottom:1px solid var(--color-border); }
  .guia-antes ul { padding-left:1.25rem; margin-bottom:0; }
  .guia-pasos { list-style:none; padding:0; margin:0; }
  .guia-pasos>li { display:grid; grid-template-columns:2.5rem minmax(0,1fr); gap:1rem; padding:2rem 0; border-bottom:1px solid var(--color-border); }
  .guia-numero { font:600 1.5rem/1.3 var(--font-mono); }
  .guia-pasos p:last-child { margin-bottom:0; }
  figure { margin:1.5rem 0 0; }
  figure img { display:block; max-width:100%; height:auto; max-height:640px; margin:auto; border:1px solid var(--color-border); }
  figcaption { margin-top:.6rem; color:var(--color-secondary-text); font-size:.8rem; line-height:1.6; }
  .guia-resultado { padding:2rem 0 1rem; }
  .guia-consejo { border-left:3px solid #d85a30; padding:.5rem 0 .5rem 1.25rem; margin:1rem 0 2rem; }
  .guia-consejo h2 { font-size:1.2rem; }
  .guia-fuentes { border-top:1px solid var(--color-border); padding-top:1.5rem; margin-top:2rem; }
  .guia-fuentes h2 { font-size:1.1rem; }
  .guia-fuentes ul { padding-left:1.25rem; }
  .guia-fuentes p { font-size:.85rem; margin:.25rem 0 1rem; }
  .guia-fuentes a,.guia-mas { color:#3558bd; text-underline-offset:4px; overflow-wrap:anywhere; }
  a:focus-visible { outline:3px solid #446ddf; outline-offset:4px; }
  @media(max-width:480px) { .guia-pasos>li { grid-template-columns:1fr; gap:.5rem; } .guia-numero { font-size:1.1rem; } }
</style>
