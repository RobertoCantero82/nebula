---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Seo from '../components/Seo.astro';
import RelojActualidad from '../components/RelojActualidad.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import { fechaPublicacion } from '../utils/publicacion';

function formatoTexto(valor: unknown): string {
  const texto = String(valor ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  function enfasis(fragmento: string): string {
    return fragmento.replace(/(\*\*\*|___)(?=\S)([\s\S]*?\S)\1(?![*_])|(\*\*|__)(?=\S)([\s\S]*?\S)\3(?![*_])|(?<!\*)\*(?=\S)([^*]*?\S)\*(?!\*)|(?<![\p{L}\p{N}_])_(?=\S)([^_]*?\S)_(?![\p{L}\p{N}_])/gu,
      (_coincidencia, triple, ambos, doble, fuerte, cursiva, cursivaGuion) => {
        if (triple) return '<strong class="enfasis-editorial"><em class="enfasis-editorial">' + enfasis(ambos) + '</em></strong>';
        if (doble) return '<strong class="enfasis-editorial">' + enfasis(fuerte) + '</strong>';
        return '<em class="enfasis-editorial">' + enfasis(cursiva ?? cursivaGuion) + '</em>';
      });
  }
  return enfasis(texto);
}
function textoPlano(valor: unknown): string {
  return formatoTexto(valor).replace(/<[^>]*>/g, '').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
}

const { pieza } = Astro.props;
const { titulo, descripcion, fecha, pasos, antesDeEmpezar, resultado, consejo, fuentes } = pieza.data;
const instante = fechaPublicacion(pieza.data).getTime();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <Seo titulo={`${textoPlano(titulo)} | Hazlo fácil | Nebula`} descripcion={textoPlano(descripcion)} tipo="article" fecha={fecha} />
    <script is:inline define:vars={{ instante }}>
      if (Date.now() < instante) document.documentElement.dataset.noticiaPendiente = 'true';
    </script>
    <style is:global>
      html[data-noticia-pendiente] body > :not([data-aviso-programada]):not(script) { display:none !important; }
      [data-aviso-programada] { display:none; }
      html[data-noticia-pendiente] [data-aviso-programada] { display:block; max-width:760px; margin:auto; padding:4rem 1.5rem; }
    </style>
  </head>
  <body>
    <aside data-aviso-programada data-desbloquear={instante}><p>Esta guía todavía no está disponible. Aparecerá al llegar su momento de publicación.</p><a href="/">Volver a Nebula</a></aside>
    <Cabecera activa="hazlo-facil" />
    <main class="guia contenedor">
      <article>
        <header class="guia-cabecera">
          <div class="guia-titular">
            <div class="guia-palabra-fondo" aria-hidden="true">{textoPlano(pieza.data.fondoPortada ?? pieza.data.palabraDestacada ?? "Fácil")}</div>
            <h1><Fragment set:html={formatoTexto(titulo)} /></h1>
          </div>
          <p class="guia-descripcion"><Fragment set:html={formatoTexto(descripcion)} /></p>
        </header>
        {antesDeEmpezar.length > 0 && <section class="guia-antes" aria-labelledby="antes"><h2 id="antes">Antes de empezar</h2><ul>{antesDeEmpezar.map(texto => <li><Fragment set:html={formatoTexto(texto)} /></li>)}</ul></section>}
        <h2 class="guia-pasos-titulo" id="paso-a-paso">Paso a paso</h2>
        <ol class="guia-pasos" aria-labelledby="paso-a-paso">
          {pasos.map((paso, indice) => <li id={`paso-${indice + 1}`}>
            <span class="guia-numero" aria-hidden="true">{String(indice + 1).padStart(2, '0')}</span>
            <div><h2><Fragment set:html={formatoTexto(paso.titulo)} /></h2>{paso.texto.map(texto => <p><Fragment set:html={formatoTexto(texto)} /></p>)}
              {paso.imagen && <figure><img src={paso.imagen} alt={textoPlano(paso.altImagen)} loading="lazy" />{paso.pieImagen && <figcaption><Fragment set:html={formatoTexto(paso.pieImagen)} /></figcaption>}</figure>}
            </div>
          </li>)}
        </ol>
        <div class="guia-ampliacion"><slot /></div>
        <section class="guia-resultado" aria-labelledby="resultado"><h2 id="resultado">Ya lo tienes</h2><p><Fragment set:html={formatoTexto(resultado)} /></p></section>
        {consejo && <aside class="guia-consejo"><h2>Un detalle útil</h2><p><Fragment set:html={formatoTexto(consejo)} /></p></aside>}
        <section class="guia-fuentes" aria-labelledby="fuentes"><h2 id="fuentes">Fuentes y ayuda</h2><ul>{fuentes.map(fuente => <li><a href={fuente.url} target="_blank" rel="noopener noreferrer">{fuente.nombre}<span class="solo-lectores"> (se abre en una nueva pestaña)</span></a>{fuente.detalle && <p><Fragment set:html={formatoTexto(fuente.detalle)} /></p>}</li>)}</ul></section>
      </article>
    </main>
    <footer class="pie-pagina contenedor"><a href="/privacidad/">Privacidad</a></footer>
    <CloudflareAnalytics /><RelojActualidad />
  </body>
</html>

<script>
  // ajusto la palabra completa al ancho real, después de cargar la tipografía
  document.querySelectorAll<HTMLElement>('.guia-palabra-fondo').forEach((palabra) => {
    const marco = palabra.parentElement;
    if (!marco) return;
    const ajustar = () => {
      palabra.style.removeProperty('font-size');
      const tamano = parseFloat(getComputedStyle(palabra).fontSize);
      const ancho = palabra.getBoundingClientRect().width;
      const disponible = marco.clientWidth * 0.92;
      if (ancho > disponible && ancho > 0) {
        palabra.style.fontSize = `${tamano * disponible / ancho}px`;
      }
    };
    const observador = new ResizeObserver(ajustar);
    observador.observe(marco);
    window.addEventListener('resize', ajustar, { passive: true });
    document.fonts.ready.then(ajustar);
    ajustar();
  });
</script>
<style>
  .guia :global(strong),.guia :global(em) { color:#d85a30; font-family:inherit; font-size:inherit; line-height:inherit; letter-spacing:inherit; }
  .guia :global(strong) { font-weight:700; }
  .guia :global(em) { font-style:italic; }
  .guia { max-width:1120px; padding-top:clamp(1.5rem,4vw,3rem); padding-bottom:4rem; }
  .guia article > :not(.guia-cabecera) { max-width:800px; margin-left:auto; margin-right:auto; }
  .guia-cabecera { padding-bottom:2rem; }
  .guia-titular { position:relative; isolation:isolate; padding-bottom:clamp(3rem,9vw,8rem); }
  .guia-palabra-fondo { position:absolute; z-index:-1; right:0; top:22%; width:max-content; max-width:none; overflow:visible; color:rgb(216 90 48 / 9%); font:700 clamp(12rem,34vw,34rem)/1 var(--font-heading); letter-spacing:-.1em; white-space:nowrap; pointer-events:none; user-select:none; }
  h1 { position:relative; color:var(--color-ink); font-size:clamp(3rem,7vw,7rem); letter-spacing:-.055em; line-height:.88; margin:0; width:100%; max-width:1050px; overflow-wrap:break-word; }
  .guia-numero { color:var(--color-ink); }
  .guia-descripcion { font-size:clamp(1.125rem,1.6vw,1.35rem); line-height:1.65; margin:2rem auto 0; max-width:65ch; text-align:center; font-style:italic; }
  h2 { font-size:clamp(1.4rem,3vw,1.8rem); line-height:1.2; margin:0 0 .8rem; }
  p,li { font-size:clamp(1.125rem,1.6vw,1.35rem); line-height:1.75; }
  .guia-ampliacion :global(p),.guia-ampliacion :global(li) { font-size:clamp(1.125rem,1.6vw,1.35rem); line-height:1.75; }
  .guia-ampliacion :global(a:focus-visible) { outline:3px solid #446ddf; outline-offset:4px; }
  .guia-antes { padding:1.75rem 0; }
  .guia-antes ul { padding-left:1.25rem; margin-bottom:0; }
  .guia-pasos { list-style:none; padding:0; margin:0; }
  .guia-pasos>li { display:grid; grid-template-columns:2.5rem minmax(0,1fr); gap:1rem; padding:2rem 0; }
  .guia-numero { font:600 1.5rem/1.3 var(--font-mono); }
  .guia-pasos p:last-child { margin-bottom:0; }
  figure { margin:1.5rem 0 0; }
  figure img { display:block; max-width:100%; height:auto; max-height:640px; margin:auto; border:1px solid var(--color-border); }
  figcaption { margin-top:.6rem; color:var(--color-secondary-text); font-size:.8rem; line-height:1.6; }
  .guia-resultado { padding:2rem 0 1rem; }
  .guia-consejo { padding:.5rem 0; margin:1rem 0 2rem; text-align:left; }
  .guia-antes h2,.guia-pasos-titulo,.guia-resultado h2,.guia-consejo h2 { color:#446ddf; font-size:clamp(1.4rem,3vw,1.8rem); line-height:1.2; margin:0 0 .8rem; text-align:left; }
  .guia-fuentes { padding-top:1.5rem; margin-top:2rem; }
  .guia-fuentes h2 { font-size:1.1rem; }
  .guia-fuentes ul { padding-left:1.25rem; }
  .guia-fuentes p { font-size:.85rem; margin:.25rem 0 1rem; }
  .guia-fuentes a { color:#3558bd; text-underline-offset:4px; overflow-wrap:anywhere; }
  a:focus-visible { outline:3px solid #446ddf; outline-offset:4px; }
  @media(max-width:650px) { .guia-palabra-fondo { font-size:52vw; right:0; top:32%; } h1 { font-size:clamp(2.8rem,14vw,4.7rem); } }
  @media(max-width:480px) { .guia-pasos>li { grid-template-columns:1fr; gap:.5rem; } .guia-numero { font-size:1.1rem; } }
</style>
