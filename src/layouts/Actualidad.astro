---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';

const { pieza } = Astro.props;
const { titulo, descripcion, categoria, fecha, cifraDestacada, etiquetaCifra, fondoPortada, mostrarCifraInterior, formato = 'base', pantallas, fuentes } = pieza.data;
const nombresCategoria = { tecnologia: 'Tecnología', ciencia: 'Ciencia', cine: 'Cine', cultura: 'Cultura', extra: 'Extra' };
const nombreCategoria = nombresCategoria[categoria];
const fechaLarga = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(fecha);
const fechaCarpeta = pieza.id.split('/')[0];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/nebula/favicon.svg?v=5" />
    <meta name="theme-color" content="#446ddf" />
    <Seo titulo={`${titulo} | Nebula`} descripcion={descripcion} />
  </head>
  <body class={`actualidad actualidad-${categoria} formato-${formato}`}>
    <header class="barra-superior">
      <a class="marca" href="/nebula/" aria-label="Volver a la portada de Nebula"><img src="/nebula/imagenes/logo-nebula-v2.png" width="172" height="57" alt="Nebula" /></a>
      <div><span>ACTUALIDAD</span><time datetime={fechaCarpeta}>{fechaLarga}</time></div>
      <a class="volver" href="/nebula/#titulo-actualidad">Las cuatro noticias <span aria-hidden="true">↗</span></a>
    </header>

    <nav class="progreso" aria-label="Recorrido de la noticia">
      <a href="#portada" aria-label="Portada"><span>00</span></a>
      {pantallas.map((pantalla, indice) => <a href={`#pantalla-${indice + 1}`} aria-label={pantalla.etiqueta}><span>0{indice + 1}</span></a>)}
    </nav>

    <main>
      <section class="pantalla pantalla-portada" id="portada" data-pantalla>
        <div class="numero-fondo" aria-hidden="true">{fondoPortada ?? cifraDestacada ?? 'HOY'}</div>
        <div class="contenido portada-contenido">
          <p class="ceja">{nombreCategoria}</p>
          <h1>{titulo}</h1>
          {formato !== 'visual' && <p class="descripcion">{descripcion}</p>}
        </div>
        <a class="seguir" href="#pantalla-1">Desplegar la historia <span aria-hidden="true">↓</span></a>
      </section>

      {pantallas.map((pantalla, indice) => (
        <section class:list={['pantalla', `pantalla-${pantalla.tipo}`, `pantalla-paso-${indice + 1}`]} id={`pantalla-${indice + 1}`} data-pantalla>
          <div class="contenido">
            <p class="ceja">{pantalla.etiqueta}</p>
            <h2>{pantalla.titulo}</h2>

            {pantalla.tipo === 'recorrido' && pantalla.datos && (
              <div class="visual visual-recorrido" aria-label={pantalla.datos.join(', después ')}>
                {pantalla.datos.map((dato, posicion) => <><span>{dato}</span>{posicion < pantalla.datos.length - 1 && <i aria-hidden="true">↓</i>}</>)}
                <b aria-hidden="true">×</b>
              </div>
            )}

            {pantalla.tipo === 'linea' && pantalla.datos && (
              <div class="visual visual-linea">
                <span>{pantalla.datos[0]}</span><div><i></i><strong>{pantalla.datos[1]}</strong><i></i></div><span>{pantalla.datos[2]}</span>
              </div>
            )}

            {pantalla.tipo === 'lista' && pantalla.datos && (
              <div class="visual visual-lista">{pantalla.datos.map((dato) => <span>{dato}</span>)}</div>
            )}

            {pantalla.tipo === 'hospital' && pantalla.datos && (
              <div class="visual visual-hospital" aria-label="Evolución de las pruebas médicas">
                <div class="historia-clinica">
                  <b>Primera visita</b>
                  <span>{pantalla.datos[0]}</span><span>{pantalla.datos[1]}</span><span>{pantalla.datos[2]}</span><span>{pantalla.datos[3]}</span>
                </div>
                <div class="espera-clinica"><strong>{pantalla.datos[4]}</strong><i aria-hidden="true">→</i></div>
                <div class="escaner-clinico">
                  <b>TC</b><div aria-hidden="true"><i></i></div><strong>{pantalla.datos[5]}</strong><span>objeto localizado</span>
                </div>
              </div>
            )}

            {pantalla.tipo === 'contraste' && pantalla.datos && (
              <div class="visual visual-contraste"><strong>{pantalla.datos[0]}</strong><i aria-hidden="true">≠</i><strong>{pantalla.datos[1]}</strong></div>
            )}

            {pantalla.tipo === 'secuencia-iconos' && pantalla.datos && (
              <div class="visual visual-iconos" aria-label={pantalla.datos.join(', después ')}>
                {pantalla.datos.map((dato, posicion) => <div class="paso-icono">
                  <span class="icono-web" aria-hidden="true">
                    {posicion === 0 && <svg viewBox="0 0 100 100"><circle cx="28" cy="72" r="17"/><circle cx="74" cy="72" r="17"/><path d="M28 72 43 42h19l12 30M43 42l25 30M43 42 28 72M38 55h28M49 32h15"/></svg>}
                    {posicion === 1 && <svg viewBox="0 0 100 100"><circle cx="50" cy="25" r="13"/><path d="M31 85V55c0-13 8-20 19-20s19 7 19 20v30M31 58 15 75M69 58l16 17M41 85V62M59 85V62"/><path class="detalle" d="M38 22h24M43 17h14"/></svg>}
                    {posicion === 2 && <svg viewBox="0 0 100 100"><path d="M16 56h44l14-12h12v20H74L60 56v17H38V64H16z"/><path class="detalle" d="M46 73v13M54 73l8 13"/></svg>}
                    {posicion === 3 && <svg viewBox="0 0 100 100"><path d="M12 68c21-5 34-20 43-43 8 23 18 35 33 42"/><circle cx="37" cy="65" r="12"/><circle cx="72" cy="65" r="12"/><path d="M37 65 49 45h13l10 20M49 45l23 20"/><path class="detalle" d="M8 82h84"/></svg>}
                  </span>
                  <strong>{dato}</strong>
                  {posicion < pantalla.datos.length - 1 && <i aria-hidden="true">→</i>}
                </div>)}
              </div>
            )}

            {pantalla.tipo === 'secuencia-xpeng' && pantalla.datos && (
              <div class="visual visual-iconos visual-iconos-xpeng" aria-label={pantalla.datos.join(', después ')}>
                {pantalla.datos.map((dato, posicion) => <div class="paso-icono">
                  <span class="icono-web" aria-hidden="true">
                    {posicion === 0 && <svg viewBox="0 0 100 100"><path d="M10 62h9l10-19h42l14 19h5v17H10z"/><circle cx="30" cy="79" r="10"/><circle cx="72" cy="79" r="10"/><path class="detalle" d="M28 43h44M50 43V28"/></svg>}
                    {posicion === 1 && <svg viewBox="0 0 100 100"><path d="M14 58h8l9-16h40l13 16h5v16H14z"/><circle cx="31" cy="74" r="9"/><circle cx="72" cy="74" r="9"/><path class="detalle" d="M56 42l19-18 11 5-15 13"/></svg>}
                    {posicion === 2 && <svg viewBox="0 0 100 100"><path d="M12 66h12l8-14h35l11 14h8v13H12z"/><circle cx="31" cy="79" r="8"/><circle cx="70" cy="79" r="8"/><path class="detalle" d="M47 50V29h24M62 20l9 9-9 9"/></svg>}
                    {posicion === 3 && <svg viewBox="0 0 100 100"><path d="M36 50h28l9 9-9 9H36l-9-9z"/><path d="M50 50V25M50 68v15M36 50 20 38M64 50l16-12M36 68 20 80M64 68l16 12"/><circle class="detalle" cx="50" cy="59" r="6"/></svg>}
                  </span>
                  <strong>{dato}</strong>
                  {posicion < pantalla.datos.length - 1 && <i aria-hidden="true">→</i>}
                </div>)}
              </div>
            )}

            {(pantalla.tipo === 'secuencia-hueso' || pantalla.tipo === 'secuencia-gameboy') && pantalla.datos && (
              <div class="visual visual-iconos" aria-label={pantalla.datos.join(', después ')}>
                {pantalla.datos.map((dato, posicion) => <div class="paso-icono">
                  <span class="icono-web" aria-hidden="true">
                    {pantalla.tipo === 'secuencia-hueso' && posicion === 0 && <svg viewBox="0 0 100 100"><path d="M20 48c15-18 45-18 60 0-15 20-45 20-60 0Z"/><path class="detalle" d="M35 50c10 7 20 7 30 0"/></svg>}
                    {pantalla.tipo === 'secuencia-hueso' && posicion === 1 && <svg viewBox="0 0 100 100"><path d="M45 18v24c0 8-12 12-12 27 0 18 14 24 29 15 18-11 17-36 2-42-8-3-9-12-9-24"/><path class="detalle" d="M34 67c9 5 18 5 28-1"/></svg>}
                    {pantalla.tipo === 'secuencia-hueso' && posicion === 2 && <svg viewBox="0 0 100 100"><path d="M25 22c-13 8-9 22 4 22 13 0 13 17 0 17s-16 17-3 19M45 20c-13 8-9 22 4 22s13 17 0 17-16 17-3 20M65 21c-13 8-9 22 4 22s13 17 0 17-16 17-3 20"/></svg>}
                    {pantalla.tipo === 'secuencia-hueso' && posicion === 3 && <svg viewBox="0 0 100 100"><path d="M20 20c10 7 18 18 18 32s9 25 23 25M61 77c13 0 18-12 12-21-4-7-14-7-19-1-4 5-3 13 2 18"/><circle class="detalle" cx="67" cy="67" r="8"/></svg>}
                    {pantalla.tipo === 'secuencia-gameboy' && posicion === 0 && <svg viewBox="0 0 100 100"><path d="M20 75 65 30l15 15-45 45H20Z"/><path class="detalle" d="m58 37 15 15M28 76l8 8"/></svg>}
                    {pantalla.tipo === 'secuencia-gameboy' && posicion === 1 && <svg viewBox="0 0 100 100"><rect x="25" y="12" width="50" height="76" rx="7"/><rect x="34" y="22" width="32" height="28"/><path d="M34 66h16M42 58v16"/><circle class="detalle" cx="61" cy="64" r="5"/></svg>}
                    {pantalla.tipo === 'secuencia-gameboy' && posicion === 2 && <svg viewBox="0 0 100 100"><rect x="18" y="18" width="64" height="64" rx="6"/><path d="m30 38 10 10-10 10M50 59h20"/><path class="detalle" d="M50 34h20"/></svg>}
                    {pantalla.tipo === 'secuencia-gameboy' && posicion === 3 && <svg viewBox="0 0 100 100"><path d="M28 35h44c10 0 18 10 15 20l-7 23c-2 8-12 9-17 2l-7-10H44l-7 10c-5 7-15 6-17-2l-7-23c-3-10 5-20 15-20Z"/><path d="M29 52h16M37 44v16"/><circle class="detalle" cx="68" cy="50" r="4"/><circle class="detalle" cx="77" cy="59" r="4"/></svg>}
                  </span>
                  <strong>{dato}</strong>{posicion < pantalla.datos.length - 1 && <i aria-hidden="true">→</i>}
                </div>)}
              </div>
            )}

            {pantalla.tipo === 'imagen-cine' && pantalla.imagen && (
              <figure class="visual imagen-cine">
                <img src={pantalla.imagen} alt={pantalla.altImagen ?? ''} />
                {pantalla.pieImagen && <figcaption>{pantalla.pieImagen}</figcaption>}
              </figure>
            )}

            {pantalla.tipo === 'video-youtube' && pantalla.videoId && (
              <figure class="visual video-actualidad">
                <div><iframe src={`https://www.youtube-nocookie.com/embed/${pantalla.videoId}?rel=0`} title={pantalla.titulo} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
                {pantalla.pieImagen && <figcaption>{pantalla.pieImagen}</figcaption>}
              </figure>
            )}

            {pantalla.tipo === 'interactivo-cine' && pantalla.datos && pantalla.respuestas && (
              <div class="visual cambios-ocultos" data-cambios-ocultos>
                <div class="cambios-ocultos__opciones" role="group" aria-label="Otros cambios de la edición de 2002">
                  {pantalla.datos.map((dato, indice) => <button type="button" class:list={{ activo: indice === 0 }} data-respuesta={pantalla.respuestas?.[indice]} aria-pressed={indice === 0 ? 'true' : 'false'}><span>0{indice + 1}</span>{dato}</button>)}
                </div>
                <div class="cambios-ocultos__revelacion" aria-live="polite">
                  <span aria-hidden="true" data-numero-cambio>01</span>
                  <p data-texto-cambio>{pantalla.respuestas[0]}</p>
                </div>
              </div>
            )}

            {pantalla.tipo === 'interactivo-datos' && pantalla.datos && pantalla.respuestas && (
              <div class="visual cambios-ocultos" data-cambios-ocultos>
                <div class="cambios-ocultos__opciones" role="group" aria-label="Explorar los datos de la noticia">
                  {pantalla.datos.map((dato, indice) => <button type="button" class:list={{ activo: indice === 0 }} data-respuesta={pantalla.respuestas?.[indice]} aria-pressed={indice === 0 ? 'true' : 'false'}><span>0{indice + 1}</span>{dato}</button>)}
                </div>
                <div class="cambios-ocultos__revelacion" aria-live="polite"><span aria-hidden="true" data-numero-cambio>01</span><p data-texto-cambio>{pantalla.respuestas[0]}</p></div>
              </div>
            )}

            {pantalla.tipo === 'interactivo-xpeng' && pantalla.datos && pantalla.respuestas && (
              <div class="visual sistema-xpeng" data-sistema-xpeng>
                <div class="sistema-xpeng__selector" role="group" aria-label="Comparar las dos partes del Land Aircraft Carrier">
                  {pantalla.datos.map((dato, indice) => <button type="button" class:list={{ activo: indice === 0 }} data-respuesta={pantalla.respuestas?.[indice]} data-indice={indice} aria-pressed={indice === 0 ? 'true' : 'false'}><span>0{indice + 1}</span>{dato}</button>)}
                </div>
                <div class="sistema-xpeng__ficha" aria-live="polite" data-ficha-xpeng>
                  <div class="sistema-xpeng__dibujo terrestre" aria-hidden="true"><i></i><i></i><i></i></div>
                  <p data-texto-xpeng>{pantalla.respuestas[0]}</p>
                </div>
              </div>
            )}

            {pantalla.tipo === 'grafico-tiempo' && pantalla.datos && (
              <figure class="visual grafico-tiempo" aria-label="Cronología de los cambios de E.T. y el arrepentimiento de Steven Spielberg">
                <div class="grafico-tiempo__cabecera"><span>TIEMPO TRANSCURRIDO</span><strong>41 años de historia</strong></div>
                <div class="grafico-tiempo__eje" aria-hidden="true">
                  <i class="tramo tramo-original"></i><i class="tramo tramo-cambio"></i><i class="tramo tramo-regreso"></i>
                  <div class="hito hito-1982"><b></b><strong>{pantalla.datos[0]}</strong><span>Estreno original</span></div>
                  <div class="hito hito-2002"><b></b><strong>{pantalla.datos[1]}</strong><span>Cambia las armas</span></div>
                  <div class="hito hito-2011"><b></b><strong>{pantalla.datos[2]}</strong><span>Admite que se arrepiente</span></div>
                  <div class="hito hito-2023"><b></b><strong>{pantalla.datos[3]}</strong><span>Lo llama «un error»</span></div>
                  <em class="intervalo intervalo-20">20 años</em><em class="intervalo intervalo-9">9 años</em><em class="intervalo intervalo-12">12 años</em>
                </div>
                <figcaption>El montaje modificado permaneció nueve años sin una rectificación pública del director.</figcaption>
              </figure>
            )}

            {pantalla.tipo === 'grafico-alcance' && pantalla.datos && (
              <figure class="visual grafico-alcance" aria-label="Comparación del alcance anunciado por carretera y en vuelo">
                <div class="grafico-alcance__cabecera"><span>ALCANCE ANUNCIADO POR LA EMPRESA</span><strong>Dos escalas muy distintas</strong></div>
                <div class="grafico-alcance__filas">
                  <div><span>Por carretera</span><i><b style="width:100%"></b></i><strong>{pantalla.datos[0]}</strong></div>
                  <div><span>En vuelo</span><i><b style="width:3%"></b></i><strong>{pantalla.datos[1]}</strong></div>
                </div>
                <figcaption>La barra compara las cifras comunicadas por XPeng. El dato terrestre corresponde al alcance combinado bajo el ciclo chino CLTC.</figcaption>
              </figure>
            )}

            {pantalla.tipo === 'grafico-comparacion' && pantalla.datos && (
              <figure class="visual grafico-comparacion" aria-label={`Comparación entre ${pantalla.datos[2]} y ${pantalla.datos[3]}`}>
                <div class="grafico-comparacion__cabecera"><span>COMPARACIÓN A ESCALA</span><strong>{pantalla.datos[0]} frente a {pantalla.datos[1]}</strong></div>
                <div class="grafico-comparacion__filas">
                  <div><span>{pantalla.datos[2]}</span><i><b style="width: 5%"></b></i><strong>{pantalla.datos[0]}</strong></div>
                  <div><span>{pantalla.datos[3]}</span><i><b style="width: 100%"></b></i><strong>{pantalla.datos[1]}</strong></div>
                </div>
                <figcaption>{pantalla.texto[1]}</figcaption>
              </figure>
            )}

            <div class="texto-ritmo">{pantalla.texto.map((parrafo) => <p>{parrafo}</p>)}</div>

            {pantalla.tipo === 'cierre' && (
              <div class="fuentes">
                <p>FUENTES CONSULTADAS</p>
                {fuentes.map((fuente) => <a href={fuente.url} target="_blank" rel="noopener noreferrer"><strong>{fuente.nombre}</strong>{fuente.detalle && <span>{fuente.detalle}</span>}<i aria-hidden="true">↗</i></a>)}
              </div>
            )}
          </div>
          {indice < pantallas.length - 1 ? <a class="seguir" href={`#pantalla-${indice + 2}`}><span class="sr-only">Continuar</span><span aria-hidden="true">↓</span></a> : <a class="seguir final" href="/nebula/#titulo-actualidad">Volver a la edición de hoy <span aria-hidden="true">↗</span></a>}
        </section>
      ))}
    </main>
    <CloudflareAnalytics />

    <script>
      const pantallas = [...document.querySelectorAll('[data-pantalla]')];
      const enlaces = [...document.querySelectorAll('.progreso a')];
      const observador = new IntersectionObserver((entradas) => {
        entradas.forEach((entrada) => {
          if (!entrada.isIntersecting) return;
          const posicion = pantallas.indexOf(entrada.target);
          enlaces.forEach((enlace, indice) => enlace.toggleAttribute('aria-current', indice === posicion));
        });
      }, { threshold: .55 });
      pantallas.forEach((pantalla) => observador.observe(pantalla));

      document.querySelectorAll('[data-cambios-ocultos]').forEach((modulo) => {
        const botones = [...modulo.querySelectorAll('button')];
        const lectura = modulo.querySelector('[data-texto-cambio]');
        const numero = modulo.querySelector('[data-numero-cambio]');
        botones.forEach((boton) => boton.addEventListener('click', () => {
          botones.forEach((otro) => { otro.classList.toggle('activo', otro === boton); otro.setAttribute('aria-pressed', String(otro === boton)); });
          if (lectura) lectura.textContent = boton.dataset.respuesta ?? '';
          if (numero) numero.textContent = `0${botones.indexOf(boton) + 1}`;
        }));
      });

      document.querySelectorAll('[data-sistema-xpeng]').forEach((modulo) => {
        const botones = [...modulo.querySelectorAll('button')];
        const lectura = modulo.querySelector('[data-texto-xpeng]');
        const ficha = modulo.querySelector('[data-ficha-xpeng]');
        botones.forEach((boton) => boton.addEventListener('click', () => {
          botones.forEach((otro) => { otro.classList.toggle('activo', otro === boton); otro.setAttribute('aria-pressed', String(otro === boton)); });
          if (lectura) lectura.textContent = boton.dataset.respuesta ?? '';
          ficha?.classList.toggle('muestra-vuelo', boton.dataset.indice === '1');
        }));
      });
    </script>
  </body>
</html>

<style>
  :global(html){scroll-behavior:smooth;scroll-snap-type:y proximity}
  :global(body.actualidad){background:#f3f0e8;color:#17162e;margin:0}
  .barra-superior{align-items:center;background:rgb(243 240 232 / 94%);border-bottom:1px solid rgb(23 22 46 / 20%);display:grid;grid-template-columns:1fr auto 1fr;left:0;padding:.75rem clamp(1rem,3vw,2.5rem);position:fixed;right:0;top:0;z-index:20}
  .marca img{display:block;height:auto;width:112px}.barra-superior>div{align-items:center;display:flex;font:600 9px var(--font-mono);gap:.75rem;letter-spacing:.08em;text-transform:uppercase}.barra-superior>div span{color:#d85a30}.volver{font:600 9px var(--font-mono);justify-self:end;text-decoration:none;text-transform:uppercase}
  .progreso{display:flex;flex-direction:column;gap:.75rem;position:fixed;right:clamp(.7rem,2vw,1.5rem);top:50%;transform:translateY(-50%);z-index:18}.progreso a{align-items:center;background:#f3f0e8;border:1px solid rgb(23 22 46 / 24%);border-radius:50%;display:flex;height:30px;justify-content:center;text-decoration:none;width:30px}.progreso span{font:8px var(--font-mono)}.progreso a[aria-current]{background:#d85a30;border-color:#d85a30;color:#fff}
