---
import { getCollection } from 'astro:content';

const { activa = '' } = Astro.props;
const enlaces = [
  { nombre: 'Análisis', ruta: '/nebula/articulos/', clave: 'analisis' },
  { nombre: 'Trama', ruta: '/nebula/trama/', clave: 'trama' },
  { nombre: 'Laboratorio', ruta: '/nebula/laboratorio/', clave: 'laboratorio' },
  { nombre: 'Sobre Nebula', ruta: '/nebula/sobre-nebula/', clave: 'sobre' },
];

const limpiarTexto = (texto = '') => texto
  .replace(/<script[\s\S]*?<\/script>/gi, ' ')
  .replace(/<style[\s\S]*?<\/style>/gi, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/[#*_`>|{}]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();

const articulos = await getCollection('articulos');
const indiceBusqueda = articulos
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .map((articulo) => ({
    titulo: articulo.data.titulo,
    descripcion: articulo.data.descripcion,
    tema: articulo.data.serie === 'trama' ? 'CINE | TRAMA' : articulo.data.tema,
    ruta: `/nebula/articulos/${articulo.id}/`,
    texto: limpiarTexto(articulo.body),
  }));

const indiceSeguro = JSON.stringify(indiceBusqueda).replace(/</g, '\\u003c');
---
<header class="cabecera contenedor">
  <a class="marca" href="/nebula/" aria-label="Ir a la portada de Nebula">
    <svg width="110" height="32" viewBox="0 0 110 32" aria-hidden="true"><circle cx="7" cy="8" r="3" fill="#D85A30" /><text x="0" y="27" font-family="Zilla Slab" font-weight="600" font-size="24" fill="#1B1836">Nebula</text></svg>
  </a>
  <div class="buscador-nebula" data-buscador>
    <label class="solo-lectores" for="busqueda-nebula">Buscar artículos por palabra clave</label>
    <div class="buscador-nebula-campo">
      <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <input id="busqueda-nebula" type="search" placeholder="Buscar en Nebula" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="resultados-busqueda-nebula" />
      <kbd aria-hidden="true">/</kbd>
    </div>
    <div class="resultados-busqueda" id="resultados-busqueda-nebula" role="listbox" hidden></div>
    <p class="estado-busqueda solo-lectores" aria-live="polite"></p>
  </div>
  <nav class="navegacion" aria-label="Navegación principal">
    {enlaces.map((enlace) => <a href={enlace.ruta} aria-current={activa === enlace.clave ? 'page' : undefined}>{enlace.nombre}</a>)}
  </nav>
</header>

<script type="application/json" id="indice-busqueda-nebula" set:html={indiceSeguro}></script>

<script>
  const raiz = document.querySelector('[data-buscador]');
  const campo = raiz?.querySelector('input');
  const resultados = raiz?.querySelector('[role="listbox"]');
  const estado = raiz?.querySelector('.estado-busqueda');
  const fuente = document.getElementById('indice-busqueda-nebula');
  const normalizar = (valor = '') => valor.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es');
  const indice = fuente?.textContent ? JSON.parse(fuente.textContent) : [];
  let coincidencias = [];

  const cerrar = () => {
    if (!campo || !resultados) return;
    resultados.hidden = true;
    resultados.replaceChildren();
    campo.setAttribute('aria-expanded', 'false');
    campo.removeAttribute('aria-activedescendant');
  };

  const abrirResultado = (posicion = 0) => {
    const elegido = coincidencias[posicion];
    if (elegido) window.location.href = elegido.ruta;
  };

  const dibujar = () => {
    if (!campo || !resultados || !estado) return;
    const consulta = normalizar(campo.value.trim());
    if (consulta.length < 2) {
      coincidencias = [];
      estado.textContent = '';
      cerrar();
      return;
    }

    const terminos = consulta.split(/\s+/).filter(Boolean);
    coincidencias = indice
      .map((articulo) => {
        const titulo = normalizar(articulo.titulo);
        const descripcion = normalizar(articulo.descripcion);
        const tema = normalizar(articulo.tema);
        const texto = normalizar(articulo.texto);
        if (!terminos.every((termino) => `${titulo} ${descripcion} ${tema} ${texto}`.includes(termino))) return null;
        const puntuacion = terminos.reduce((total, termino) => total
          + (titulo.includes(termino) ? 12 : 0)
          + (tema.includes(termino) ? 6 : 0)
          + (descripcion.includes(termino) ? 4 : 0)
          + (texto.includes(termino) ? 1 : 0), 0);
        return { ...articulo, puntuacion };
      })
      .filter(Boolean)
      .sort((a, b) => b.puntuacion - a.puntuacion)
      .slice(0, 6);

    resultados.replaceChildren();
    coincidencias.forEach((articulo, posicion) => {
      const enlace = document.createElement('a');
      enlace.href = articulo.ruta;
      enlace.id = `resultado-nebula-${posicion}`;
      enlace.setAttribute('role', 'option');
      enlace.innerHTML = `<span>${articulo.tema}</span><strong></strong><small></small>`;
      enlace.querySelector('strong').textContent = articulo.titulo;
      enlace.querySelector('small').textContent = articulo.descripcion;
      resultados.appendChild(enlace);
    });

    if (!coincidencias.length) {
      const vacio = document.createElement('p');
      vacio.className = 'busqueda-sin-resultados';
      vacio.textContent = 'No hay artículos con esas palabras.';
      resultados.appendChild(vacio);
    }

    resultados.hidden = false;
    campo.setAttribute('aria-expanded', 'true');
    estado.textContent = coincidencias.length === 1 ? 'Un resultado encontrado.' : `${coincidencias.length} resultados encontrados.`;
  };

  campo?.addEventListener('input', dibujar);
  campo?.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape') {
      cerrar();
      campo.blur();
    }
    if (evento.key === 'Enter' && coincidencias.length) {
      evento.preventDefault();
      abrirResultado(0);
    }
    if (evento.key === 'ArrowDown' && coincidencias.length) {
      evento.preventDefault();
      resultados?.querySelector('a')?.focus();
    }
  });
  resultados?.addEventListener('keydown', (evento) => {
    const opciones = [...resultados.querySelectorAll('a')];
    const actual = opciones.indexOf(document.activeElement);
    if (evento.key === 'ArrowDown') {
      evento.preventDefault();
      opciones[(actual + 1) % opciones.length]?.focus();
    }
    if (evento.key === 'ArrowUp') {
      evento.preventDefault();
      (actual <= 0 ? campo : opciones[actual - 1])?.focus();
    }
    if (evento.key === 'Escape') {
      cerrar();
      campo?.focus();
    }
  });
  document.addEventListener('click', (evento) => {
    if (raiz && !raiz.contains(evento.target)) cerrar();
  });
  document.addEventListener('keydown', (evento) => {
    if (evento.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      evento.preventDefault();
      campo?.focus();
    }
  });
</script>
