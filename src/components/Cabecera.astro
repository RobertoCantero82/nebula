---
import { getCollection } from 'astro:content';
import MusicaNebula from './MusicaNebula.astro';
import { fechaPublicacion, estaPublicada } from '../utils/publicacion';

const { activa = '' } = Astro.props;
const gruposMenu = [
  { id: 'secciones', nombre: 'Secciones', enlaces: [
    { nombre: 'Actualidad', descripcion: 'Noticias breves para descubrir qué está pasando.', ruta: '/actualidad/', clave: 'actualidad' },
    { nombre: 'Historias con datos', descripcion: 'Preguntas, gráficos e historias para entender el mundo.', ruta: '/articulos/', clave: 'analisis' },
    { nombre: 'Trama', descripcion: 'Conexiones inesperadas entre películas.', ruta: '/trama/', clave: 'trama' },
    { nombre: 'Más Cosme', descripcion: 'Las aventuras del personaje de Nebula.', ruta: '/mas-cosme/', clave: 'cosme' },
  ]},
  { id: 'temas', nombre: 'Temas', enlaces: [
    { nombre: 'Tecnología', descripcion: 'Inteligencia artificial, dispositivos y el mundo digital.', ruta: '/temas/tecnologia/', clave: 'tecnologia' },
    { nombre: 'Ciencia', descripcion: 'Espacio, naturaleza e investigación.', ruta: '/temas/ciencia/', clave: 'ciencia' },
    { nombre: 'Cine', descripcion: 'Películas, series e historias de la pantalla.', ruta: '/temas/cine/', clave: 'cine' },
    { nombre: 'Extra', descripcion: 'Cultura, deporte y otras historias.', ruta: '/temas/extra/', clave: 'extra' },
  ]},
  { id: 'conoce', nombre: 'Conoce Nebula', enlaces: [
    { nombre: 'Sobre Nebula', descripcion: 'El proyecto y su forma de contar historias.', ruta: '/sobre-nebula/', clave: 'sobre' },
    { nombre: 'Patrocinios y colaboraciones', descripcion: 'Propuestas para colaborar con Nebula.', ruta: '/colabora/', clave: 'colabora' },
    { nombre: 'Roberto Cantero', descripcion: 'Mi perfil profesional y cómo trabajar conmigo.', ruta: '/trabaja-conmigo/', clave: 'perfil' },
    { nombre: 'Mis proyectos · Laboratorio', descripcion: 'Herramientas, agentes y experimentos que puedes probar.', ruta: '/laboratorio/', clave: 'laboratorio' },
  ]},
];

const limpiarTexto = (texto = '') => texto
  .replace(/<script[\s\S]*?<\/script>/gi, ' ')
  .replace(/<style[\s\S]*?<\/style>/gi, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/[#*_`>|{}]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();

const ahora = new Date();
const articulos = (await getCollection('articulos')).filter(articulo => estaPublicada(articulo.data, ahora));
const actualidad = await getCollection('actualidad');
const indiceBusqueda = [
  ...articulos
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .map((articulo) => ({
    titulo: articulo.data.titulo,
    descripcion: articulo.data.descripcion,
    tema: articulo.data.serie === 'trama' ? 'CINE | TRAMA' : articulo.data.tema,
    ruta: `/articulos/${articulo.id}/`,
    texto: limpiarTexto(articulo.body),
  })),
  ...actualidad
    .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
    .map((pieza) => ({
      publicar: fechaPublicacion(pieza.data).getTime(),
      titulo: pieza.data.titulo,
      descripcion: pieza.data.descripcion,
      tema: `ACTUALIDAD | ${pieza.data.categoria.toUpperCase()}`,
      ruta: `/actualidad/${pieza.id}/`,
      texto: limpiarTexto(pieza.body),
    })),
];

const indiceSeguro = JSON.stringify(indiceBusqueda).replace(/</g, '\\u003c');
---
<header class="cabecera contenedor">
  <MusicaNebula />
  <div class="buscador-nebula" data-buscador>
    <label class="solo-lectores" for="busqueda-nebula">Buscar artículos por palabra clave</label>
    <div class="buscador-nebula-campo">
      <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <input id="busqueda-nebula" type="search" placeholder="Buscar en Nebula" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="resultados-busqueda-nebula" />
      <kbd aria-hidden="true">/</kbd>
    </div>
    <div class="resultados-busqueda" id="resultados-busqueda-nebula" role="listbox" hidden></div>
    <p class="estado-busqueda solo-lectores" aria-live="polite"></p>
  </div>
  <nav class="menu-nebula" aria-label="Navegación principal" data-menu-nebula>
    <button class="menu-disparador" type="button" aria-expanded="false" aria-controls="panel-menu-nebula" data-menu-boton><span data-menu-texto>Menú</span> <span aria-hidden="true" data-menu-icono>☰</span></button>
    <div class="menu-panel" id="panel-menu-nebula" hidden>
      <div class="menu-grupos" role="tablist" aria-label="Explorar Nebula" aria-orientation="vertical">
        {gruposMenu.map((grupo, i) => <button type="button" role="tab" id={`menu-tab-${grupo.id}`} aria-controls={`menu-contenido-${grupo.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-menu-grupo={grupo.id}>{grupo.nombre}<span aria-hidden="true">›</span></button>)}
      </div>
      <div class="menu-contenidos">
        {gruposMenu.map((grupo, i) => <div id={`menu-contenido-${grupo.id}`} role="tabpanel" aria-labelledby={`menu-tab-${grupo.id}`} hidden={i !== 0} data-menu-contenido={grupo.id}>
          {grupo.enlaces.map(enlace => <a href={enlace.ruta} aria-current={activa === enlace.clave ? 'page' : undefined}><strong>{enlace.nombre}</strong><span>{enlace.descripcion}</span></a>)}
        </div>)}
      </div>
    </div>
  </nav>
</header>

<style>
  .menu-nebula { position:relative; width:min(100%,900px); justify-self:center; text-align:center; z-index:30; }
  .menu-disparador { appearance:none; background:none; border:0; color:#1b1836; cursor:pointer; font:600 18px/1.5 var(--font-mono); padding:.5rem 1rem; display:inline-flex; align-items:center; gap:.7rem; }
  .menu-panel { position:absolute; top:calc(100% + .6rem); left:50%; transform:translateX(-50%); width:min(680px,100%); max-height:min(65vh,560px); overflow-y:auto; display:grid; grid-template-columns:minmax(125px,.8fr) minmax(0,2fr); text-align:left; background:#f7f5f0; border:1px solid #d9d5c8; box-shadow:0 18px 45px rgb(27 24 54 / 18%); }
  .menu-panel[hidden], [data-menu-contenido][hidden] { display:none !important; }
  .menu-grupos { border-right:1px solid #d9d5c8; padding:.75rem 0; background:#eeece6; }
  .menu-grupos button { appearance:none; width:100%; display:flex; align-items:center; justify-content:space-between; gap:.4rem; border:0; background:none; color:#1b1836; cursor:pointer; font:600 14px/1.4 var(--font-heading); text-align:left; padding:1rem; }
  .menu-grupos button[aria-selected="true"] { color:#3558bd; background:#f7f5f0; box-shadow:inset 3px 0 #446ddf; }
  .menu-contenidos { min-width:0; padding:.6rem 1rem; }
  .menu-contenidos a { display:block; text-decoration:none; padding:.85rem .5rem; border-bottom:1px solid #e3dfd5; }
  .menu-contenidos a:last-child { border-bottom:0; }
  .menu-contenidos strong { display:block; color:#3558bd; font:600 18px/1.3 var(--font-heading); }
  .menu-contenidos a>span { display:block; color:#555363; font:12px/1.5 var(--font-body); margin-top:.25rem; }
  .menu-contenidos a:hover strong { text-decoration:underline; text-underline-offset:4px; }
  .menu-nebula button:focus-visible,.menu-contenidos a:focus-visible { outline:3px solid #446ddf; outline-offset:-3px; }
  @media(max-width:480px) { .menu-panel { grid-template-columns:112px minmax(0,1fr); } .menu-grupos button { font-size:13px; padding:.85rem .65rem; } .menu-contenidos { padding:.4rem .55rem; } .menu-contenidos strong { font-size:16px; } .menu-contenidos a>span { font-size:11px; } }
  .marca-logo { display: block; height: auto; width: clamp(150px, 14vw, 172px); }
</style>

<script type="application/json" id="indice-busqueda-nebula" set:html={indiceSeguro}></script>

<script>
import { navigate } from 'astro:transitions/client';
import { alCargarPagina } from '../scripts/ciclo-pagina';
alCargarPagina((escuchar, alSalir) => {
const menu = document.querySelector<HTMLElement>('[data-menu-nebula]');
const botonMenu = menu?.querySelector<HTMLButtonElement>('[data-menu-boton]');
const panelMenu = menu?.querySelector<HTMLElement>('.menu-panel');
const grupos = [...(menu?.querySelectorAll<HTMLButtonElement>('[data-menu-grupo]') || [])];
const mostrarMenu = (abierto: boolean, devolverFoco = false) => {
  if (!botonMenu || !panelMenu) return;
  panelMenu.hidden = !abierto;
  botonMenu.setAttribute('aria-expanded', String(abierto));
  botonMenu.querySelector('[data-menu-texto]')!.textContent = abierto ? 'Cerrar' : 'Menú';
  botonMenu.querySelector('[data-menu-icono]')!.textContent = abierto ? '✕' : '☰';
  if (devolverFoco) botonMenu.focus();
};
const activarGrupo = (elegido: HTMLButtonElement) => {
  grupos.forEach(boton => { const activo = boton === elegido; boton.setAttribute('aria-selected', String(activo)); boton.tabIndex = activo ? 0 : -1; });
  menu?.querySelectorAll<HTMLElement>('[data-menu-contenido]').forEach(panel => { panel.hidden = panel.dataset.menuContenido !== elegido.dataset.menuGrupo; });
};
if (botonMenu) escuchar(botonMenu, 'click', () => mostrarMenu(botonMenu.getAttribute('aria-expanded') !== 'true'));
grupos.forEach((boton, i) => {
  escuchar(boton, 'click', () => activarGrupo(boton));
  escuchar(boton, 'keydown', (evento: KeyboardEvent) => {
    let siguiente: HTMLButtonElement | undefined;
    if (evento.key === 'ArrowDown') siguiente = grupos[(i + 1) % grupos.length];
    if (evento.key === 'ArrowUp') siguiente = grupos[(i - 1 + grupos.length) % grupos.length];
    if (evento.key === 'Home') siguiente = grupos[0];
    if (evento.key === 'End') siguiente = grupos[grupos.length - 1];
    if (siguiente) { evento.preventDefault(); activarGrupo(siguiente); siguiente.focus(); }
    if (evento.key === 'ArrowRight') { evento.preventDefault(); menu?.querySelector<HTMLElement>('[data-menu-contenido]:not([hidden]) a')?.focus(); }
  });
});
escuchar(document, 'click', (evento: MouseEvent) => { if (menu && !menu.contains(evento.target as Node)) mostrarMenu(false); });
escuchar(document, 'keydown', (evento: KeyboardEvent) => { if (evento.key === 'Escape' && panelMenu && !panelMenu.hidden) { evento.preventDefault(); mostrarMenu(false, true); } });

const raiz = document.querySelector('[data-buscador]');
  const campo = raiz?.querySelector('input');
  const resultados = raiz?.querySelector('[role="listbox"]');
  const estado = raiz?.querySelector('.estado-busqueda');
  const fuente = document.getElementById('indice-busqueda-nebula');
  const normalizar = (valor = '') => valor.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es');
  const indice = fuente?.textContent ? JSON.parse(fuente.textContent) : [];
  let coincidencias = [];

  const cerrar = () => {
    if (!campo || !resultados) return;
    resultados.hidden = true;
    resultados.replaceChildren();
    campo.setAttribute('aria-expanded', 'false');
    campo.removeAttribute('aria-activedescendant');
  };

  escuchar(document, 'nebula:publicacion', () => { if (campo === document.activeElement) dibujar(); });

  const abrirResultado = (posicion = 0) => {
    const elegido = coincidencias[posicion];
    if (elegido) void navigate(elegido.ruta);
  };

  const dibujar = () => {
    if (!campo || !resultados || !estado) return;
    const consulta = normalizar(campo.value.trim());
    if (consulta.length < 2) {
      coincidencias = [];
      estado.textContent = '';
      cerrar();
      return;
    }

    const terminos = consulta.split(/\s+/).filter(Boolean);
    coincidencias = indice
      .filter(articulo => !articulo.publicar || articulo.publicar <= Date.now())
      .map((articulo) => {
        const titulo = normalizar(articulo.titulo);
        const descripcion = normalizar(articulo.descripcion);
        const tema = normalizar(articulo.tema);
        const texto = normalizar(articulo.texto);
        if (!terminos.every((termino) => `${titulo} ${descripcion} ${tema} ${texto}`.includes(termino))) return null;
        const puntuacion = terminos.reduce((total, termino) => total
          + (titulo.includes(termino) ? 12 : 0)
          + (tema.includes(termino) ? 6 : 0)
          + (descripcion.includes(termino) ? 4 : 0)
          + (texto.includes(termino) ? 1 : 0), 0);
        return { ...articulo, puntuacion };
      })
      .filter(Boolean)
      .sort((a, b) => b.puntuacion - a.puntuacion)
      .slice(0, 6);

    resultados.replaceChildren();
    coincidencias.forEach((articulo, posicion) => {
      const enlace = document.createElement('a');
      enlace.href = articulo.ruta;
      enlace.id = `resultado-nebula-${posicion}`;
      enlace.setAttribute('role', 'option');
      enlace.innerHTML = `<span>${articulo.tema}</span><strong></strong><small></small>`;
      enlace.querySelector('strong').textContent = articulo.titulo;
      enlace.querySelector('small').textContent = articulo.descripcion;
      resultados.appendChild(enlace);
    });

    if (!coincidencias.length) {
      const vacio = document.createElement('p');
      vacio.className = 'busqueda-sin-resultados';
      vacio.textContent = 'No hay artículos con esas palabras.';
      resultados.appendChild(vacio);
    }

    resultados.hidden = false;
    campo.setAttribute('aria-expanded', 'true');
    estado.textContent = coincidencias.length === 1 ? 'Un resultado encontrado.' : `${coincidencias.length} resultados encontrados.`;
  };

  campo?.addEventListener('input', dibujar);
  campo?.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape') {
      cerrar();
      campo.blur();
    }
    if (evento.key === 'Enter' && coincidencias.length) {
      evento.preventDefault();
      abrirResultado(0);
    }
    if (evento.key === 'ArrowDown' && coincidencias.length) {
      evento.preventDefault();
      resultados?.querySelector('a')?.focus();
    }
  });
  resultados?.addEventListener('keydown', (evento) => {
    const opciones = [...resultados.querySelectorAll('a')];
    const actual = opciones.indexOf(document.activeElement);
    if (evento.key === 'ArrowDown') {
      evento.preventDefault();
      opciones[(actual + 1) % opciones.length]?.focus();
    }
    if (evento.key === 'ArrowUp') {
      evento.preventDefault();
      (actual <= 0 ? campo : opciones[actual - 1])?.focus();
    }
    if (evento.key === 'Escape') {
      cerrar();
      campo?.focus();
    }
  });
  escuchar(document, 'click', (evento) => {
    if (raiz && !raiz.contains(evento.target)) cerrar();
  });
  escuchar(document, 'keydown', (evento) => {
    if (evento.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      evento.preventDefault();
      campo?.focus();
    }
  });

});
</script>
