---
const { activa = '' } = Astro.props;
const enlaces = [
  { nombre: 'Análisis', ruta: '/nebula/articulos/', clave: 'analisis' },
  { nombre: 'Trama', ruta: '/nebula/trama/', clave: 'trama' },
  { nombre: 'Laboratorio', ruta: '/nebula/laboratorio/', clave: 'laboratorio' },
  { nombre: 'Sobre Nebula', ruta: '/nebula/sobre-nebula/', clave: 'sobre' },
];
---
<header class="cabecera contenedor">
  <a class="marca" href="/nebula/" aria-label="Ir a la portada de Nebula">
    <svg width="110" height="32" viewBox="0 0 110 32" aria-hidden="true"><circle cx="7" cy="8" r="3" fill="#D85A30" /><text x="0" y="27" font-family="Zilla Slab" font-weight="600" font-size="24" fill="#1B1836">Nebula</text></svg>
  </a>
  <nav class="navegacion" aria-label="Navegación principal">
    {enlaces.map((enlace) => <a href={enlace.ruta} aria-current={activa === enlace.clave ? 'page' : undefined}>{enlace.nombre}</a>)}
  </nav>
</header>
