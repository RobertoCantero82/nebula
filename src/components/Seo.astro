---
interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
  tipo?: 'website' | 'article';
  fecha?: Date;
}

const {
  titulo,
  descripcion,
  imagen,
  tipo = 'website',
  fecha,
} = Astro.props;

const origen = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origen);
const imagenSocial = imagen ? new URL(imagen, origen) : undefined;
---

<title>{titulo}</title>
<meta name="description" content={descripcion} />
<meta name="author" content="Roberto Cantero" />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/nebula/sitemap.xml" />

<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="Nebula" />
<meta property="og:type" content={tipo} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonical} />
{imagenSocial && <meta property="og:image" content={imagenSocial} />}
{imagenSocial && <meta property="og:image:alt" content={titulo} />}
{tipo === 'article' && fecha && <meta property="article:published_time" content={fecha.toISOString()} />}

<meta name="twitter:card" content={imagenSocial ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
{imagenSocial && <meta name="twitter:image" content={imagenSocial} />}
{imagenSocial && <meta name="twitter:image:alt" content={titulo} />}
