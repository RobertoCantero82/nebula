---
const { articulos = [] } = Astro.props;
---

{articulos.length > 0 && (
  <section class="relacionados" aria-labelledby="titulo-relacionados">
    <div class="relacionados-cabecera">
      <p>MÁS EN NEBULA</p>
      <h2 id="titulo-relacionados">Sigue leyendo</h2>
    </div>

    <div class="relacionados-grid">
      {articulos.map((articulo) => (
        <a href={`/nebula/articulos/${articulo.id}/`}>
          <div class="relacionado-imagen">
            {articulo.data.imagenPortada
              ? <img src={articulo.data.imagenPortada} alt="" loading="lazy" />
              : <div class="relacionado-placeholder"></div>}
          </div>
          <div class="relacionado-contenido">
            <p>{articulo.data.tema}</p>
            <h3>{articulo.data.titulo}</h3>
            <span>Leer el análisis <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .relacionados {
    border-top: 1px solid var(--color-border);
    margin-top: clamp(4rem, 8vw, 6rem);
    padding-top: 1.5rem;
  }
  .relacionados-cabecera { align-items: end; display: flex; justify-content: space-between; margin-bottom: 1.5rem; }
  .relacionados-cabecera p { color: var(--color-accent); font: 10px var(--font-mono); letter-spacing: .09em; margin: 0; }
  .relacionados-cabecera h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); margin: 0; }
  .relacionados-grid { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); }
  .relacionados-grid > a { background: #fff; border: 1px solid var(--color-border); display: block; text-decoration: none; }
  .relacionado-imagen { aspect-ratio: 16 / 9; background: #eeeae1; overflow: hidden; }
  .relacionado-imagen img { display: block; height: 100%; object-fit: cover; transition: transform .25s ease; width: 100%; }
  .relacionado-placeholder { background: linear-gradient(135deg, var(--color-ink), #446ddf); height: 100%; }
  .relacionado-contenido { padding: 1.2rem; }
  .relacionado-contenido > p { color: #446ddf; font: 600 9px var(--font-mono); letter-spacing: .04em; margin: 0 0 .7rem; }
  .relacionado-contenido h3 { font-size: 1.2rem; line-height: 1.17; margin: 0 0 1.2rem; }
  .relacionado-contenido > span { font: 600 10px var(--font-mono); }
  .relacionados-grid > a:hover { box-shadow: 0 10px 28px rgb(27 24 54 / 9%); }
  .relacionados-grid > a:hover img { transform: scale(1.025); }

  @media (max-width: 760px) {
    .relacionados-cabecera { align-items: start; flex-direction: column; gap: .5rem; }
    .relacionados-grid { grid-template-columns: 1fr; }
    .relacionados-grid > a { display: grid; grid-template-columns: 140px 1fr; }
    .relacionado-imagen { aspect-ratio: auto; min-height: 145px; }
  }

  @media (max-width: 460px) {
    .relacionados-grid > a { display: block; }
    .relacionado-imagen { aspect-ratio: 16 / 9; min-height: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .relacionado-imagen img { transition: none; }
  }
</style>
