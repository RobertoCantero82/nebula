---
const frases = [
  "Sigue al conejo blanco. O empieza por la primera noticia, que queda más cerca.",
  "Las carreteras las ponemos nosotros. Tú trae la curiosidad.",
  "Hemos visto cosas que no creerías. Y hemos comprobado las fuentes.",
  "Que la curiosidad te acompañe.",
  "Siempre nos quedará otra historia.",
  "Tenemos la sensación de que ya no estamos en Kansas. Vamos a comprobarlo.",
  "La primera regla de Nebula es hacer preguntas. La segunda, comprobar las respuestas.",
  "Hasta el infinito hay bastante camino. Empecemos por una buena historia.",
  "Houston, tenemos una pregunta.",
  "La curiosidad encuentra un camino. Nosotros intentamos seguirle el paso.",
  "Vamos a necesitar un cuaderno más grande.",
  "Hay una historia ahí fuera. Y tenemos ganas de encontrarla.",
  "Carpe diem. Pero antes, un vistazo a lo que está pasando.",
  "Te haremos una pregunta que no podrás dejar de darle vueltas.",
  "El mundo es una caja de sorpresas. Aquí miramos qué pone en la etiqueta.",
  "¿Datos? Donde vamos, sí necesitamos datos.",
  "Abre bien los ojos. La pista puede estar en el siguiente plano.",
  "A veces basta con cambiar de plano para entender la historia.",
  "No hemos venido a salvar el mundo. Hoy nos conformamos con entenderlo un poco mejor.",
  "La curiosidad ha entrado en el edificio.",
  "Si esta historia tuviera una escena después de los créditos, nos quedaríamos a verla.",
  "La respuesta está ahí fuera. Las fuentes, al final del artículo.",
  "La realidad tiene mejores giros que algunos guiones. Vamos a ver el de hoy.",
  "Bienvenido al otro lado de la pantalla. Aquí también hay cosas por descubrir."
];
const zona = 'Europe/Madrid';
const ahora = new Date();
const dia = new Intl.DateTimeFormat('sv-SE', { timeZone: zona, year: 'numeric', month: '2-digit', day: '2-digit' }).format(ahora);
const indice = Math.floor(Date.parse(`${dia}T00:00:00Z`) / 86400000) % frases.length;
const hora = Number(new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: 'numeric', hourCycle: 'h23' }).format(ahora));
const saludo = hora >= 6 && hora < 14 ? 'Buenos días' : hora >= 14 && hora < 21 ? 'Buenas tardes' : 'Buenas noches';
const fecha = new Intl.DateTimeFormat('es-ES', { timeZone: zona, weekday: 'long', day: 'numeric', month: 'long' }).format(ahora);
const reloj = new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(ahora);
---
<div class="saludo-portada contenedor">
  <div class="bienvenida" data-bienvenida data-frases={JSON.stringify(frases)}>
    <p class="bienvenida-frase" data-saludo-portada>{saludo}. {frases[indice]}</p>
    <p class="bienvenida-fecha" data-bienvenida-fecha>Hoy es {fecha} y son las {reloj}.</p>
  </div>
</div>
<style>
  .saludo-portada { padding-top:clamp(1.25rem,3vw,1.75rem); padding-bottom:clamp(1.25rem,3vw,1.75rem); }
  .bienvenida { padding:0; text-align:center; }
  .bienvenida-frase { color:#446ddf; font:600 clamp(1.1rem,1.9vw,1.4rem)/1.45 var(--font-heading); margin:0 auto; max-width:65ch; text-wrap:pretty; }
  .bienvenida-fecha { color:#446ddf; font:400 clamp(.85rem,1.2vw,.95rem)/1.5 var(--font-body); margin:.6rem 0 0; }
</style>
<script>
  import { alCargarPagina } from '../scripts/ciclo-pagina';
  alCargarPagina((escuchar, alSalir) => {
    const modulo = document.querySelector<HTMLElement>('[data-bienvenida]');
    if (!modulo) return;
    const frase = modulo.querySelector<HTMLElement>('[data-saludo-portada]')!;
    const fecha = modulo.querySelector<HTMLElement>('[data-bienvenida-fecha]')!;
    const frases: string[] = JSON.parse(modulo.dataset.frases || '[]');
    const zona = 'Europe/Madrid';
    const formatoDia = new Intl.DateTimeFormat('sv-SE', { timeZone: zona, year: 'numeric', month: '2-digit', day: '2-digit' });
    const formatoFecha = new Intl.DateTimeFormat('es-ES', { timeZone: zona, weekday: 'long', day: 'numeric', month: 'long' });
    const formatoReloj = new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    const formatoHora = new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: 'numeric', hourCycle: 'h23' });
    const actualizar = () => {
      const ahora = new Date();
      const hora = Number(formatoHora.format(ahora));
      const saludo = hora >= 6 && hora < 14 ? 'Buenos días' : hora >= 14 && hora < 21 ? 'Buenas tardes' : 'Buenas noches';
      const indice = Math.floor(Date.parse(`${formatoDia.format(ahora)}T00:00:00Z`) / 86400000) % frases.length;
      const texto = `${saludo}. ${frases[indice]}`;
      const momento = `Hoy es ${formatoFecha.format(ahora)} y son las ${formatoReloj.format(ahora)}.`;
      if (frase.textContent !== texto) frase.textContent = texto;
      if (fecha.textContent !== momento) fecha.textContent = momento;
    };
    actualizar();
    const intervalo = window.setInterval(actualizar, 1000);
    alSalir(() => window.clearInterval(intervalo));
    escuchar(window, 'focus', actualizar);
    escuchar(document, 'visibilitychange', actualizar);
  });
</script>
