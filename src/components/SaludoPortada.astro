---
const frases = [
  "Que las fuentes te acompañen.",
  "La verdad está ahí fuera. Empieza a buscarla por aquí.",
  "Houston, tienes una noticia por descubrir.",
  "Sigue al conejo blanco. El primer enlace lo tienes aquí.",
  "¿Datos? Donde vas, vas a necesitar datos.",
  "Siempre te quedará la hemeroteca.",
  "Vas a leer cosas que no creerías. Por eso te dejamos las fuentes.",
  "La primera regla del clic: no te quedes en el titular.",
  "Vas a necesitar una pantalla más grande. O bajar un poco más.",
  "Hasta el último enlace y más allá. Tú eliges hasta dónde leer.",
  "Te haremos una pregunta que no podrás rechazar.",
  "Carpe diem. Aprovecha el día para descubrir algo.",
  "Solo puede quedar uno. ¿Con qué titular te quedas hoy?",
  "Se acerca el invierno. Ponte al día antes de que llegue.",
  "No es la isla de Lost, pero aquí también vas a hacerte preguntas.",
  "El de las noticias que todavía no has leído. Dale al siguiente episodio.",
  "Teléfono, mi casa. Ya que lo tienes en la mano, lee algo bueno.",
  "La actualidad es como una caja de bombones. Abre y descubre qué te toca.",
  "Ya no estás en Kansas. Estás a un clic de descubrir algo.",
  "Nos encanta que tus preguntas salgan bien. Empieza por una.",
  "¿Me estás leyendo a mí? Entonces sigue, que hay más.",
  "Elemental, querido lector. La pista está un poco más abajo.",
  "Volverás. Pero antes, échale un ojo a esta historia.",
  "Por si no volvemos a leernos: buenas tardes y buenas noches.",
  "La curiosidad es fuerte en ti. Dale una buena historia.",
  "Lee o no leas, pero no te quedes solo en el titular.",
  "Un gran clic conlleva una gran responsabilidad. Elige qué lees.",
  "Descubre el lado luminoso de tu pantalla.",
  "Que la suerte esté siempre de tu parte. Y las fuentes, a tu alcance.",
  "Tu nombre es Lector. Lector curioso.",
  "Pide tu actualidad agitada, no manipulada.",
  "No son tus años, son tus lecturas. Suma una más.",
  "¿Por qué tan serio? También puedes disfrutar informándote.",
  "Elige: seguir deslizando o encontrar algo que merezca la pena.",
  "¿Puedes encajar la verdad? Empieza por leerla entera.",
  "Pide que te enseñen los datos. Aquí puedes empezar por ellos.",
  "Mi tesoro… Tu próximo hallazgo puede estar en esta portada.",
  "No se entra así como así en Mordor. Aquí puedes pasar sin llamar.",
  "Un enlace para encontrarlas a todas. Elige tu primera historia.",
  "Un Lannister siempre paga sus deudas. Tú puedes saldar las tuyas con la actualidad.",
  "Lo que leas hoy tendrá su eco en tu próxima conversación.",
  "Asómate a la actualidad. Puedes hacerlo sin subirte a la proa del Titanic.",
  "Que nadie te deje en un rincón. Entra en la conversación.",
  "Tienes que volver, Jack. Te has dejado una noticia sin leer.",
  "Nos vemos en otra pestaña, hermano. Antes, descubre esta historia.",
  "¡Bazinga! Ya tienes una excusa para aprender algo nuevo.",
  "Eso es lo que dice… la fuente original. Puedes leerla tú también.",
  "Elige la pastilla roja. Hoy puedes empezar por una noticia.",
  "Tienes un amigo en mí. Y unas cuantas historias aquí debajo.",
  "¿A dónde vas? Para ponerte al día no necesitas un DeLorean."
];
const zona = 'Europe/Madrid';
const ahora = new Date();
const hora = Number(new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: 'numeric', hourCycle: 'h23' }).format(ahora));
const saludo = hora >= 6 && hora < 14 ? 'Buenos días' : hora >= 14 && hora < 21 ? 'Buenas tardes' : 'Buenas noches';
const fecha = new Intl.DateTimeFormat('es-ES', { timeZone: zona, weekday: 'long', day: 'numeric', month: 'long' }).format(ahora);
const reloj = new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(ahora);
---
<div class="saludo-portada contenedor">
  <div class="bienvenida" data-bienvenida data-frases={JSON.stringify(frases)}>
    <p class="bienvenida-fecha" data-bienvenida-fecha>{saludo}. Hoy es {fecha}, y son las {reloj}.</p>
    <p class="bienvenida-frase" data-saludo-portada>{frases[0]}</p>
  </div>
</div>
<style>
  .saludo-portada { padding-top:clamp(.5rem,1vw,.75rem); padding-bottom:clamp(1rem,2vw,1.25rem); }
  .bienvenida { padding:0; text-align:center; }
  .bienvenida-frase { color:#446ddf; font:600 clamp(1.1rem,1.9vw,1.4rem)/1.45 var(--font-heading); margin:.45rem auto 0; max-width:65ch; text-wrap:pretty; }
  .bienvenida-fecha { color:#446ddf; font:400 clamp(.85rem,1.2vw,.95rem)/1.5 var(--font-body); margin:0; }
</style>
<script>
  import { alCargarPagina } from '../scripts/ciclo-pagina';
  alCargarPagina((escuchar, alSalir) => {
    const modulo = document.querySelector<HTMLElement>('[data-bienvenida]');
    if (!modulo) return;
    const frase = modulo.querySelector<HTMLElement>('[data-saludo-portada]')!;
    const fecha = modulo.querySelector<HTMLElement>('[data-bienvenida-fecha]')!;
    const frases: string[] = JSON.parse(modulo.dataset.frases || '[]');
    if (!frases.length) return;
    const elegirFrase = () => {
      let anterior = frase.textContent;
      try {
        anterior = window.localStorage.getItem('nebula-ultima-frase') || anterior;
      } catch { /* el saludo funciona también con el almacenamiento bloqueado */ }
      const opciones = frases.filter(texto => texto !== anterior);
      const texto = opciones.length ? opciones[Math.floor(Math.random() * opciones.length)] : frases[0];
      frase.textContent = texto;
      try {
        window.localStorage.setItem('nebula-ultima-frase', texto);
      } catch { /* la frase sigue visible aunque no se pueda guardar */ }
    };
    elegirFrase();
    const zona = 'Europe/Madrid';
    const formatoFecha = new Intl.DateTimeFormat('es-ES', { timeZone: zona, weekday: 'long', day: 'numeric', month: 'long' });
    const formatoReloj = new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    const formatoHora = new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: 'numeric', hourCycle: 'h23' });
    const actualizar = () => {
      const ahora = new Date();
      const hora = Number(formatoHora.format(ahora));
      const saludo = hora >= 6 && hora < 14 ? 'Buenos días' : hora >= 14 && hora < 21 ? 'Buenas tardes' : 'Buenas noches';
      const momento = `${saludo}. Hoy es ${formatoFecha.format(ahora)}, y son las ${formatoReloj.format(ahora)}.`;
      if (fecha.textContent !== momento) fecha.textContent = momento;
    };
    actualizar();
    const intervalo = window.setInterval(actualizar, 1000);
    alSalir(() => window.clearInterval(intervalo));
    escuchar(window, 'focus', actualizar);
    escuchar(window, 'pageshow', (evento: PageTransitionEvent) => {
      if (evento.persisted) { elegirFrase(); actualizar(); }
    });
    escuchar(document, 'visibilitychange', actualizar);
  });
</script>
