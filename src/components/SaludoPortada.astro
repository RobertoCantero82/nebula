const zona = 'Europe/Madrid';
const ahora = new Date();
const hora = Number(new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: 'numeric', hourCycle: 'h23' }).format(ahora));
const saludo = hora >= 6 && hora < 14 ? 'Buenos días' : hora >= 14 && hora < 21 ? 'Buenas tardes' : 'Buenas noches';
const fecha = new Intl.DateTimeFormat('es-ES', { timeZone: zona, weekday: 'long', day: 'numeric', month: 'long' }).format(ahora);
const reloj = new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(ahora);
---
<div class="saludo-portada contenedor">
  <div class="bienvenida" data-bienvenida data-frases={JSON.stringify(frases)}>
    <p class="bienvenida-fecha" data-bienvenida-fecha>{saludo}. Hoy es {fecha}, y son las {reloj}.</p>
    <p class="bienvenida-frase" data-saludo-portada>{frases[0].antes}<em>{frases[0].titulo}</em>{frases[0].despues}</p>
  </div>
</div>
<style>
  .saludo-portada { padding-top:clamp(.5rem,1vw,.75rem); padding-bottom:clamp(1rem,2vw,1.25rem); }
  .bienvenida { padding:0; text-align:center; }
  .bienvenida-frase { color:#446ddf; font:600 clamp(1.1rem,1.9vw,1.4rem)/1.45 var(--font-heading); margin:.45rem auto 0; max-width:65ch; text-wrap:pretty; }
  .bienvenida-fecha { color:#446ddf; font:400 clamp(.85rem,1.2vw,.95rem)/1.5 var(--font-body); margin:0; }
</style>
<script>
  import { alCargarPagina } from '../scripts/ciclo-pagina';
  alCargarPagina((escuchar, alSalir) => {
    const modulo = document.querySelector<HTMLElement>('[data-bienvenida]');
    if (!modulo) return;
    const frase = modulo.querySelector<HTMLElement>('[data-saludo-portada]')!;
    const fecha = modulo.querySelector<HTMLElement>('[data-bienvenida-fecha]')!;
    const frases: { antes: string; titulo: string; despues: string }[] = JSON.parse(modulo.dataset.frases || '[]');
    if (!frases.length) return;
    const elegirFrase = () => {
      let anterior = frase.textContent;
      try {
        anterior = window.localStorage.getItem('nebula-ultima-frase') || anterior;
      } catch { /* el saludo funciona también con el almacenamiento bloqueado */ }
      const opciones = frases.filter(item => `${item.antes}${item.titulo}${item.despues}` !== anterior);
      const elegida = opciones.length ? opciones[Math.floor(Math.random() * opciones.length)] : frases[0];
      const texto = `${elegida.antes}${elegida.titulo}${elegida.despues}`;
      const titulo = document.createElement('em');
      titulo.textContent = elegida.titulo;
      frase.replaceChildren(document.createTextNode(elegida.antes), titulo, document.createTextNode(elegida.despues));
      try {
        window.localStorage.setItem('nebula-ultima-frase', texto);
      } catch { /* la frase sigue visible aunque no se pueda guardar */ }
    };
    elegirFrase();
    const zona = 'Europe/Madrid';
    const formatoFecha = new Intl.DateTimeFormat('es-ES', { timeZone: zona, weekday: 'long', day: 'numeric', month: 'long' });
    const formatoReloj = new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    const formatoHora = new Intl.DateTimeFormat('es-ES', { timeZone: zona, hour: 'numeric', hourCycle: 'h23' });
    const actualizar = () => {
      const ahora = new Date();
      const hora = Number(formatoHora.format(ahora));
      const saludo = hora >= 6 && hora < 14 ? 'Buenos días' : hora >= 14 && hora < 21 ? 'Buenas tardes' : 'Buenas noches';
      const momento = `${saludo}. Hoy es ${formatoFecha.format(ahora)}, y son las ${formatoReloj.format(ahora)}.`;
      if (fecha.textContent !== momento) fecha.textContent = momento;
    };
    actualizar();
    const intervalo = window.setInterval(actualizar, 1000);
    alSalir(() => window.clearInterval(intervalo));
    escuchar(window, 'focus', actualizar);
    escuchar(window, 'pageshow', (evento: PageTransitionEvent) => {
      if (evento.persisted) { elegirFrase(); actualizar(); }
    });
    escuchar(document, 'visibilitychange', actualizar);
  });
</script>
