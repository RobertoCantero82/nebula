---
import { readdirSync } from 'node:fs';
const pistas = readdirSync('public/musica/')
  .filter(nombre => /\.mp3$/i.test(nombre)).sort()
  .map(nombre => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/musica/${encodeURIComponent(nombre)}`);
---
<div class="musica-marca" data-musica-nebula data-pistas={JSON.stringify(pistas)}>
  <button class="marca musica-boton" type="button" aria-label="Reproducir música de Nebula" aria-pressed="false" aria-describedby="musica-aviso">
    <span class="musica-logo">
      <img src="/nebula/imagenes/logo-nebula-v2.png" width="172" height="57" alt="Nebula" />
      <svg class="musica-radar" viewBox="480 0 390 370" aria-hidden="true">
        <g fill="none" stroke="#121334" stroke-width="13"><circle cx="650" cy="210" r="136"/><circle cx="650" cy="210" r="94"/><circle cx="650" cy="210" r="52"/></g>
        <g class="musica-aguja"><path d="M650 210 817 40" stroke="#ff5a12" stroke-width="39" stroke-linecap="round"/></g>
      </svg>
    </span>
  </button>
  <p id="musica-aviso" aria-live="polite">¿Te apetece música? Pulsa el logo</p>
  <a class="musica-inicio" href="/nebula/">Inicio</a>
</div>
<style>
  .musica-marca{justify-self:center;text-align:center;max-width:100%}
  .musica-boton{appearance:none;background:none;border:0;padding:0;cursor:pointer;height:auto;display:block;margin:auto;color:inherit}
  .musica-boton:focus-visible{outline:3px solid #446ddf;outline-offset:6px;border-radius:4px}
  .musica-logo{display:block;position:relative;width:clamp(150px,14vw,172px);line-height:0}
  .musica-logo img{display:block;width:100%;height:auto;clip-path:polygon(0 0,23% 0,23% 50%,39% 50%,39% 0,100% 0,100% 100%,0 100%)}
  .musica-radar{position:absolute;left:22.18%;top:0;width:18.02%;height:auto;overflow:visible}
  .musica-aguja{transform-origin:650px 210px;animation:musica-giro 4s linear infinite;animation-play-state:paused}
  .musica-marca[data-sonando] .musica-aguja{animation-play-state:running}
  #musica-aviso{color:#555363;font-size:12px;line-height:1.5;margin:.45rem 0 .15rem}
  .musica-inicio{color:#555363;font-size:11px;text-underline-offset:3px}
  @keyframes musica-giro{to{transform:rotate(360deg)}}
  @media(prefers-reduced-motion:reduce){.musica-aguja{animation:none}.musica-marca[data-sonando] .musica-radar{filter:drop-shadow(0 0 2px #d85a30)}}
</style>
<script>
  import '../scripts/musica-nebula';
</script>
