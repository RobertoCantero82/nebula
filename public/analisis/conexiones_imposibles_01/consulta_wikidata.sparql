SELECT DISTINCT ?person1 ?person1Label ?middle ?middleLabel ?person2 ?person2Label WHERE {
  VALUES ?credit { wdt:P161 wdt:P57 wdt:P58 wdt:P86 wdt:P162 wdt:P1040 wdt:P344 wdt:P725 }
  VALUES ?credit2 { wdt:P161 wdt:P57 wdt:P58 wdt:P86 wdt:P162 wdt:P1040 wdt:P344 wdt:P725 }
  VALUES ?credit3 { wdt:P161 wdt:P57 wdt:P58 wdt:P86 wdt:P162 wdt:P1040 wdt:P344 wdt:P725 }
  VALUES ?credit4 { wdt:P161 wdt:P57 wdt:P58 wdt:P86 wdt:P162 wdt:P1040 wdt:P344 wdt:P725 }

  wd:Q492214 ?credit ?person1.
  ?middle ?credit2 ?person1.
  ?middle ?credit3 ?person2.
  wd:Q498434 ?credit4 ?person2.
  ?middle wdt:P31/wdt:P279* wd:Q11424.
  FILTER(?person1 != ?person2)

  SERVICE wikibase:label { bd:serviceParam wikibase:language "es,en". }
}
